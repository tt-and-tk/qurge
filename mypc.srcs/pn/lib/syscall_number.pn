// Qosmosのシステムコールの取り決め(値の並べ方・各機能の番号・戻り値)．OSのシステムコールハンドラと，実行ファイル向けのライブラリの両方が取り込む
// 実行ファイルは，SPが指す番地から順に，戻り値の置き場・機能の番号・引数4つを4バイトずつ並べてから，システムコールの命令でカーネルモードへ入る
// SPが4の倍数でないか，並べた値が領域に収まらない場合，OSは機能によらず何もせずに実行ファイルへ戻る
// 値を読めた場合，実行ファイルを終える機能(SYS_EXIT)では，OSは実行ファイルへ戻らず，置き場も書き換えない
// それ以外の機能の場合，OSは戻り値を置き場へ書き込んでから実行ファイルへ戻る．戻り値は0以上が成功(子を起動する機能では，子が終わるまで待てたこと)，負の値がエラーを表す
#pragma once

// SPが指す番地から並べる値の位置(SPからの4バイト単位の順番)
const int SYSCALL_ARG_RESULT = 0;  // 戻り値の置き場(OSが書き込む)
const int SYSCALL_ARG_NUMBER = 1;  // 機能の番号
const int SYSCALL_ARG_A = 2;       // 1つ目の引数
const int SYSCALL_ARG_B = 3;       // 2つ目の引数
const int SYSCALL_ARG_C = 4;       // 3つ目の引数
const int SYSCALL_ARG_D = 5;       // 4つ目の引数
const int SYSCALL_ARGS_SIZE = 24;  // 並べる値全体のバイト数

// 各機能の番号
const int SYS_FILE_SIZE = 0;      // ファイルの大きさ(バイト数)を返す(a: 名前)
const int SYS_FILE_READ = 1;      // ファイルの内容を丸ごと読み込み，そのバイト数を返す(a: 名前，b: 読み込み先，c: 読み込み先のバイト数)
const int SYS_FILE_WRITE = 2;     // ファイルの内容を丸ごと置き換え，0を返す．ファイルが無ければ作成する(a: 名前，b: 書き込む内容，c: そのバイト数)
const int SYS_CONSOLE_READ = 3;   // コンソールから1行を受け取ってヌル終端付きで格納し，格納した文字数を返す(a: 格納先，b: 格納先のバイト数)
const int SYS_CONSOLE_WRITE = 4;  // バイト列をコンソールへ出力し，0を返す(a: 出力するバイト列，b: そのバイト数)
const int SYS_EXIT = 5;           // 実行ファイルを終え，起動した側(シェルか親の実行ファイル)へ戻る．戻り値の置き場には何も書き込まない(a: 終了状態)．Pynesisのコンパイラはmainの終了をこの番号で伝える
const int SYS_SPAWN = 6;          // /binの実行ファイルを子として起動し，終わるまで待つ．終了のシステムコールで終われば，終了状態を格納先へ書き込んで0を返し，例外で終われば例外の原因の番号を返す(a: 半角空白で区切ったコマンド名と引数の1行，b: 終了状態の格納先)

// エラーを表す戻り値
const int SYSCALL_ERR_UNKNOWN = -1;         // 未定義の番号を渡した
const int SYSCALL_ERR_INVALID = -2;         // 引数の値が不正(番地が領域の外を指す，バイト数に機能が受け付けない値を渡した，子を起動する機能で1行が63文字を超えるかコマンド名が無いか終了状態の格納先が4の倍数でない)
const int SYSCALL_ERR_TOO_LARGE = -3;       // ファイルが読み込み先に収まらないか，大きさがintで表せない
const int SYSCALL_ERR_NOT_FOUND = -4;       // 指定した名前のファイルが無い
const int SYSCALL_ERR_IS_DIR = -5;          // 指定した名前がディレクトリを指す
const int SYSCALL_ERR_BAD_NAME = -6;        // 名前が8.3形式に収まらないか，名前に使えない文字を含む
const int SYSCALL_ERR_FULL = -7;            // SDカードに空きが無い
const int SYSCALL_ERR_IO = -8;              // SDカードを読み書きできないか，ファイルシステムの記録が壊れている
const int SYSCALL_ERR_NOT_EXECUTABLE = -9;  // 起動を求めたファイルが，実行ファイルの形式の条件に合わない
const int SYSCALL_ERR_NO_MEMORY = -10;      // 起動を求めた実行ファイルに，必要な大きさの領域を割り振れない

// 子を起動する機能が返す，子を終わらせた例外の原因の番号(EXCEPTION_NONE以外は，CPUが例外ハンドラへ飛ぶときにECAUSEへ書き込む値)
const int EXCEPTION_NONE = 0;         // 例外で終わっていないことを表す
const int EXCEPTION_FETCH = 1;        // 命令を取り出す番地が範囲外である
const int EXCEPTION_ILLEGAL = 2;      // 不正な命令である
const int EXCEPTION_PRIVILEGED = 3;   // カーネルモードでだけ許される操作を，ユーザーモードで行おうとした
const int EXCEPTION_DIVIDE_ZERO = 4;  // 割り算の除数が0である
const int EXCEPTION_MEMORY = 5;       // メモリを読み書きする番地が範囲外である
