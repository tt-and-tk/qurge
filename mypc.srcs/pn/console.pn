// シェルの入出力(以下コンソール)を担う関数群．TCPで接続した相手がいればその接続でtelnetのプロトコルに従って，いなければPS(ARM)を経由して入出力する
// TCPの接続では，打った文字の表示(エコー)と1行の編集をこのファイルで行う．PSを経由する場合は，エコーをPS側のプログラムが，編集を組み込み関数scanが行う
// SCAN命令は入力が届くまで待ち続け，その間はTCPの受信を確かめられないため，入力はどちらか一方から受け取る
//
// telnetは，TCPの接続の上で文字をやり取りする取り決めである．送るバイトの大半は文字のデータで，その間に，相手との取り決めや指示を表すコマンドを混ぜる
// コマンドは値0xFFのバイト(IAC)で始まり，続くバイトがコマンドの種類を表す．データの0xFFは，コマンドと区別するためIACを2つ並べて送る
// コマンドには次の3種類がある(各コマンドの値は，定数の「telnetのコマンドの値」を参照)
// - 交渉のコマンド: IAC，コマンド，オプションの番号の3バイトで送り，オプションと呼ぶ機能(エコーなど)を使うかを取り決める
//   - WILL: 送り手がその機能を使うと申し出る．または，受け手からの要求(DO)に同意する
//   - WONT: 送り手がその機能を使わないと伝える．または，受け手からの要求(DO)を断る
//   - DO: 受け手にその機能を使うよう要求する．または，受け手からの申し出(WILL)に同意する
//   - DONT: 受け手にその機能を使わないよう要求する．または，受け手からの申し出(WILL)を断る
// - サブネゴシエーション: IAC SB，オプションの番号，値，IAC SEの順に送り，オプションに付随する値(端末の種類の名前など)を伝える
// - そのほかのコマンド: IACとコマンドの2バイトで送り，処理の中断や応答の確認などの指示を表す
// 例えば，エコーをこちらで行うと申し出るには0xFF 0xFB 0x01(IAC WILL ECHO)を送り，相手は同意すれば0xFF 0xFD 0x01(IAC DO ECHO)を返す
#pragma once
#include "tcp.pn"

const int CONSOLE_PORT = 23;            // 接続を待ち受けるポート番号(telnetの標準のポート番号)
const int CONSOLE_OUTPUT_SIZE = 256;    // TCPへ送る前の出力をためるバッファのバイト数
const int CONSOLE_INPUT_SIZE = 64;      // TCPから受信したデータを置くバッファのバイト数
const int CONSOLE_PS_CHUNK_SIZE = 32;   // PSへ出力する一時バッファの要素数(ヌル終端の分を含む)
const int CONSOLE_DECIMAL_SIZE = 12;    // 10進数を出力する一時バッファの要素数(intで最も長い"-2147483648"とヌル終端の分)

// 1行の編集に使う文字コード
const int CONSOLE_BS = 0x08;   // BS(バックスペース)
const int CONSOLE_DEL = 0x7f;  // DEL(バックスペースキーでBSの代わりに送られることがある)

// telnetのコマンドの値
const unsigned char TELNET_IAC = 0xff;   // IAC(続くバイトがコマンドであることを示す)
const unsigned char TELNET_DONT = 0xfe;  // DONT
const unsigned char TELNET_DO = 0xfd;    // DO
const unsigned char TELNET_WONT = 0xfc;  // WONT
const unsigned char TELNET_WILL = 0xfb;  // WILL
const unsigned char TELNET_SB = 0xfa;    // SB(サブネゴシエーションの始まり)
const unsigned char TELNET_SE = 0xf0;    // SE(サブネゴシエーションの終わり)

// telnetのオプションの番号
const unsigned char TELNET_ECHO = 1;  // エコー(相手が打った文字の表示を，こちらが行う)
const unsigned char TELNET_SGA = 3;   // SGA(Suppress Go Ahead．送り終えるたびに送るGAというコマンドを省き，1文字ずつ送り合えるようにする)

// telnetの受信の状態(受信したバイトをデータとして扱うかコマンドとして扱うかの判断に使う)
const int TELNET_STATE_DATA = 0;     // データを受け取っている
const int TELNET_STATE_COMMAND = 1;  // IACの直後
const int TELNET_STATE_OPTION = 2;   // 交渉のコマンドの直後(オプションの番号を待っている)
const int TELNET_STATE_SUB = 3;      // サブネゴシエーションの中
const int TELNET_STATE_SUB_IAC = 4;  // サブネゴシエーションの中のIACの直後

int console_connected = 0;                    // TCPで相手と接続しているか(0:していない，1:している)
char console_output[CONSOLE_OUTPUT_SIZE];     // TCPへ送る前の出力
int console_output_length = 0;                // 送る前の出力のバイト数
char console_last_output = 0;                 // TCPへ最後に出力した文字(改行の前に復帰を補うかの判断に使う)
char console_input[CONSOLE_INPUT_SIZE];       // TCPから受信したデータ
int console_input_length = 0;                 // 受信したデータのバイト数
int console_input_position = 0;               // 受信したデータのうち，次に処理する位置
int console_after_cr = 0;                     // 直前に受け取った文字が復帰(CR)か(0:違う，1:復帰)
int console_telnet_state = TELNET_STATE_DATA; // telnetの受信の状態
unsigned char console_telnet_command = 0;     // 受け取った交渉のコマンド(オプションの番号を待つ間に控える)
int console_echo = 0;                         // エコーのオプションが有効か(0:無効，1:有効．有効な間だけ打った文字を表示する)
int console_sga = 0;                          // SGAのオプションが有効か(0:無効，1:有効．GAは有効・無効によらず送らない)

// TCPの接続を閉じ，以降の入出力をPSへ切り替える．送る前の出力と処理する前の受信データは捨てる
void console_disconnect(void) {
    // 接続を閉じる
    tcp_close();
    // 接続していない状態へ戻す
    console_connected = 0;
    // 次の接続へ持ち越さないよう，送る前の出力と受信したデータを捨てる
    console_output_length = 0;
    console_input_length = 0;
    console_input_position = 0;
    console_after_cr = 0;
    // 受信の区切りをまたいで途中まで受け取ったtelnetのコマンドも捨てる
    console_telnet_state = TELNET_STATE_DATA;
}

// ためた出力をTCPの接続へ送る．送れなければ接続を閉じる
// 送信は1回ごとに完了を待つため，出力のたびに送らず，ためてまとめて送る
void console_flush(void) {
    int status;  // 送信の結果

    // 送るものが無ければ何もしない
    if (console_output_length == 0) {
        return;
    }
    // ためた出力を送る
    status = tcp_send(console_output, console_output_length);
    // 送ったものは捨てる
    console_output_length = 0;
    // 送れなければ相手との接続が切れているため，接続を閉じる
    if (status != TCP_OK) {
        console_disconnect();
    }
}

// TCPで接続していれば，送る前の出力の末尾に1文字加え，バッファが満杯になれば送る．接続していなければ捨てる
void console_put(char c) {
    // 接続が切れた後に加えた文字を次の接続へ持ち越さないよう，接続していなければ捨てる
    if (console_connected == 0) {
        return;
    }
    // バッファの末尾に加える
    console_output[console_output_length] = c;
    console_output_length++;
    // 改行の前に復帰を補うかの判断に使うため，加えた文字を控える
    console_last_output = c;
    // 満杯になれば送る
    if (console_output_length == CONSOLE_OUTPUT_SIZE) {
        console_flush();
    }
}

// バイト列を，PSを経由して出力する
// 値0のバイトは，printがヌル終端とみなすため出力しない
void console_write_ps(char *data, int length) {
    char chunk[CONSOLE_PS_CHUNK_SIZE];  // printへ渡す一時バッファ(printは配列変数のみ受け付けるため)
    int count = 0;                      // 一時バッファに写したバイト数

    // 値0以外のバイトを一時バッファへ写し，満杯になるたびに出力する
    for (int i = 0; i < length; i++) {
        // 値0のバイトは写さない
        if (data[i] == '\0') {
            continue;
        }
        // 一時バッファへ写す
        chunk[count] = data[i];
        count++;
        // ヌル終端の分を残して満杯になれば，終端して出力する
        if (count == CONSOLE_PS_CHUNK_SIZE - 1) {
            chunk[count] = '\0';
            print(chunk);
            count = 0;
        }
    }
    // 一時バッファに残った分を終端して出力する
    chunk[count] = '\0';
    print(chunk);
}

// バイト列を，TCPの接続へ送るため送信前のバッファへ加える．途中で接続が切れれば，残りはPSを経由して出力する
// 値0のバイトは出力しない．値0xFFのバイトは，telnetのコマンドと区別するため2つ並べる
// 改行(LF)の直前が復帰(CR)でなければ復帰を補う(端末が改行だけでは行頭へ戻らないため)
void console_write_tcp(char *data, int length) {
    // 1バイトずつ送る前の出力へ加える
    for (int i = 0; i < length; i++) {
        // 値0のバイトは読み飛ばす
        // PSへは出力できない値のため，PSへ出す場合と表示を合わせる
        // 値0のバイトは，ファイルの内容を出力するコマンドで値0を含むファイルを指定すると渡される
        if (data[i] == '\0') {
            continue;
        }
        // 直前が復帰ではない改行であれば，復帰を補う
        if (
            // 改行である
            data[i] == '\n'
            // 直前に出力した文字が復帰ではない
            && console_last_output != '\r'
        ) {
            console_put('\r');
        }
        // 値0xFFであれば，同じ値を先に1つ加える(符号付きのcharでは-1になるため，下位8ビットで比べる)
        if ((data[i] & 0xff) == TELNET_IAC) {
            console_put(TELNET_IAC);
        }
        // ここまでの送信で接続が切れていれば，このバイトから後はPSへ出す
        // このバイトの前に加えたバイトの送信で切れた場合にもこのバイトを失わないよう，加えた後に確かめる
        if (console_connected == 0) {
            console_write_ps(data + i, length - i);
            return;
        }
        // バイトを加える
        console_put(data[i]);
    }
}

// バイト列をコンソールへ出力する．TCPで接続していればその接続へ，していなければPSへ出す
// どちらへ出す場合も値0のバイトは出力しない．TCPへ出す場合は，さらにtelnetの端末に合わせて変換する(バイト列をTCPへ出力する関数を参照)
void console_write(char *data, int length) {
    // 接続していればTCPの接続へ，していなければPSへ出す
    if (console_connected) {
        console_write_tcp(data, length);
    } else {
        console_write_ps(data, length);
    }
}

// ヌル終端の文字列をコンソールへ出力する(出力先と変換は，バイト列を出力する場合と同じ)
void console_print(char *text) {
    int length = 0;  // 文字列のバイト数

    // ヌル終端までのバイト数を数える
    while (text[length] != '\0') {
        length++;
    }
    // 数えたバイト数を出力する
    console_write(text, length);
}

// valueを符号付きの10進数でコンソールへ出力する(改行は付けない)
void console_print_decimal(int value) {
    char text[CONSOLE_DECIMAL_SIZE];          // 出力する文字列
    char reversed[CONSOLE_DECIMAL_SIZE];      // 数字を下の桁から順に並べたもの
    unsigned int rest = (unsigned int)value;  // まだ数字にしていない上位の桁の値
    int count = 0;                            // reversedに並べた桁数
    int length = 0;                           // textに書いた文字数

    // 負の数は符号を書き，符号なしのまま反転して絶対値にする(intの最小値を符号付きで反転すると桁あふれするため)
    if (value < 0) {
        text[length] = '-';
        length++;
        rest = 0 - rest;
    }
    // 下の桁から1桁ずつ数字にする(値が0でも1桁は出力するため，判定は1桁作った後に行う)
    while (1) {
        reversed[count] = '0' + rest % 10;
        count++;
        rest = rest / 10;
        if (rest == 0) {
            break;
        }
    }
    // 上の桁から順になるよう並べ直す
    while (count > 0) {
        count--;
        text[length] = reversed[count];
        length++;
    }
    // 終端して出力する
    text[length] = '\0';
    console_print(text);
}

// telnetの交渉のコマンドを，オプションの番号を添えて送る前の出力へ加える
// 加えたIACはコマンドの始まりを表すため，データの0xFFのように2つ並べることはしない
void console_telnet_send(unsigned char command, unsigned char option) {
    // IAC，コマンド，オプションの番号の順に加える
    console_put(TELNET_IAC);
    console_put(command);
    console_put(option);
}

// TCPの接続が無ければ，待ち受けて相手が接続するまで待ち，接続した相手へtelnetのオプションを申し出る
// 起動時のネットワークの設定に失敗しているか待ち受けを始められなければ，接続せずに戻る(入出力はPSを経由する)
// 戻り値: 1(新たに接続した) / 0(既に接続しているか，接続せずに戻った)
int console_accept(void) {
    int status;  // TCPの各関数の結果

    // 既に接続していれば何もしない
    if (console_connected) {
        return 0;
    }
    // 相手との接続が確立するまで，待ち受けを繰り返す
    while (1) {
        // 待ち受けを始める
        status = tcp_listen(CONSOLE_PORT);
        // ネットワークを使えなければ，PSを経由する
        if (status == TCP_ERR_NOT_READY) {
            return 0;
        }
        // モジュールが待ち受けの状態にならなければ，そのことを出力して(接続していないためPSへ出る)，PSを経由する
        if (status != TCP_OK) {
            console_print("console: cannot listen\n");
            return 0;
        }
        // 待ち受けを始めたことを，ポート番号を添えて出力する(接続していないためPSへ出る)
        console_print("listening on port ");
        console_print_decimal(CONSOLE_PORT);
        console_print("\n");
        // 相手が接続するまで待ち，確立すれば待ち受けを終える(確立の途中で相手が中断すれば，待ち受けからやり直す)
        if (tcp_accept() == TCP_OK) {
            break;
        }
    }
    // 以降の入出力をTCPの接続へ切り替える
    console_connected = 1;
    // 新しい接続では，改行の前の復帰を直前の出力によらず補うようにする
    console_last_output = 0;
    // 相手へオプションを申し出る．申し出は送る前の出力へ加え，ほかの出力と一緒に送る
    // 申し出たオプションは，相手が断ればそのときに無効へ戻すため，同意を待たずに有効とする
    // エコーを有効にする
    console_echo = 1;
    // エコーをこちらで行うと申し出る(相手の端末は，打った文字を自分では表示しなくなる)
    console_telnet_send(TELNET_WILL, TELNET_ECHO);
    // SGAを有効にする
    console_sga = 1;
    // GAを省くと申し出る(相手の端末は，1文字打つたびに送るようになる)
    console_telnet_send(TELNET_WILL, TELNET_SGA);
    return 1;
}

// ためた出力を送ってから，TCPの接続を閉じる．接続していなければ何もしない
void console_close(void) {
    // 接続していなければ何もしない
    if (console_connected == 0) {
        return;
    }
    // ためた出力を送る(送れなければ，この中で接続が閉じる)
    console_flush();
    // まだ接続していれば閉じる
    if (console_connected) {
        console_disconnect();
    }
}

// TCPの接続から受信したデータを1バイトだけ取り出す．受信したデータをすべて取り出し終えていれば，次のデータが届くまで待つ
// 戻り値: 取り出したバイトの値(0〜255) / -1(接続が閉じた)
int console_receive_byte(void) {
    int status;  // 受信の結果
    int b;       // 取り出したバイトの値

    // 受信したデータのバイトをすべて取り出し終えていれば，1バイト以上受信できるまで受信を繰り返す
    // 1回の受信で複数のバイトが届いた場合，残りは受信したデータに置いたまま，次の呼び出しから1バイトずつ取り出す
    while (console_input_position == console_input_length) {
        // 相手が待たずに済むよう，待つ前にエコーなどのためた出力を送る
        console_flush();
        // 送れずに接続が閉じていれば，受け取れない
        if (console_connected == 0) {
            return -1;
        }
        // 受信したデータを読み出す(届いていなければ0バイトになり，読み出し直す)
        status = tcp_recv(console_input, CONSOLE_INPUT_SIZE, &console_input_length);
        // 読み出したデータの先頭から処理する
        console_input_position = 0;
        // 相手が切断したか接続が切れていれば，接続を閉じる
        if (status != TCP_OK) {
            console_disconnect();
            return -1;
        }
    }
    // 次の1バイトを取り出す(符号付きのcharで負になる0x80以上の値を，0〜255として扱う)
    b = console_input[console_input_position] & 0xff;
    console_input_position++;
    return b;
}

// 自分の側のオプションを，相手の要求(DO:有効にする，DONT:無効にする)どおりに切り替え，切り替えたことを応答する
// 既に要求どおりであれば，自分の申し出への同意か重複した要求のため応答しない(応答し合いが続かないようにするため)
void console_telnet_switch(int *enabled, unsigned char command, unsigned char option) {
    int requested = (command == TELNET_DO);  // 要求された状態(0:無効，1:有効)

    // 既に要求どおりであれば何もしない
    if (*enabled == requested) {
        return;
    }
    // 要求どおりに切り替える
    *enabled = requested;
    // 有効にしたならWILL，無効にしたならWONTを応答する
    if (requested) {
        console_telnet_send(TELNET_WILL, option);
    } else {
        console_telnet_send(TELNET_WONT, option);
    }
}

// 相手から受け取った交渉のコマンドに応じて，自分の側のオプションを切り替えるか，要求・申し出を断る
// 相手の同意や拒否には応答しない(応答し合いが続かないようにするため)
void console_telnet_negotiate(unsigned char command, unsigned char option) {
    // 相手が自分の側でオプションを使うと申し出てきた(WILL)ときは，DONTを返してすべて断る
    // 相手の端末は端末の種類や画面の大きさを伝える機能などを申し出てくるが，Qosmosはそれらの値を使わないため
    if (command == TELNET_WILL) {
        console_telnet_send(TELNET_DONT, option);
        return;
    }
    // 相手の側のオプションを無効にする申し出(WONT)には，既に無効のため応答しない
    if (command == TELNET_WONT) {
        return;
    }
    // 自分の側のオプションについての要求(DO・DONT)は，対応するオプションであれば切り替え，それ以外は断る
    if (option == TELNET_ECHO) {
        // エコーを切り替える
        console_telnet_switch(&console_echo, command, option);
    } else if (option == TELNET_SGA) {
        // SGAを切り替える
        console_telnet_switch(&console_sga, command, option);
    } else if (command == TELNET_DO) {
        // 対応しないオプションを有効にする要求は断る(無効にする要求には，既に無効のため応答しない)
        console_telnet_send(TELNET_WONT, option);
    }
}

// TCPの接続から受信したデータのうち，telnetのコマンドを除いたデータを1文字だけ取り出す．取り出せる文字が無ければ，次のデータが届くまで待つ
// 交渉のコマンドには応答し，それ以外のコマンドは読み捨てる
// 戻り値: 取り出した文字の値(0〜255) / -1(接続が閉じた)
int console_receive_char(void) {
    int b;  // 受信したバイトの値

    // データの1文字が得られるまで，受信したバイトを1つずつ処理する
    // 受信の区切りをまたいだコマンドも扱えるよう，どこまで受け取ったかは受信の状態として呼び出しをまたいで控える
    // 交渉への応答は送る前の出力へ加わり，次に受信を待つときにためた出力と一緒に送られる
    while (1) {
        // 1バイト取り出す
        b = console_receive_byte();
        // 接続が閉じていれば，受け取れない
        if (b < 0) {
            return -1;
        }
        // 受信の状態に応じて，バイトをデータとして返すか，コマンドの一部として処理して状態を進める
        if (console_telnet_state == TELNET_STATE_DATA) {
            // データの途中では，IACであればコマンドの始まりとして次のバイトを待ち，それ以外はデータの1文字とする
            if (b == TELNET_IAC) {
                console_telnet_state = TELNET_STATE_COMMAND;
                continue;
            }
            return b;
        } else if (console_telnet_state == TELNET_STATE_COMMAND) {
            // IACの直後では，バイトの値に応じてコマンドを判別する
            if (b == TELNET_IAC) {
                // IACが2つ並んでいれば，データの0xFFとする
                console_telnet_state = TELNET_STATE_DATA;
                return b;
            } else if (b >= TELNET_WILL && b <= TELNET_DONT) {
                // 交渉のコマンド(値が連続するWILL〜DONTの範囲)であれば，控えて続くオプションの番号を待つ
                console_telnet_command = b;
                console_telnet_state = TELNET_STATE_OPTION;
            } else if (b == TELNET_SB) {
                // サブネゴシエーションの始まりであれば，終わりまで読み捨てる
                console_telnet_state = TELNET_STATE_SUB;
            } else {
                // ほかのコマンドはオプションの番号を伴わないため，このバイトだけ読み捨てる
                console_telnet_state = TELNET_STATE_DATA;
            }
        } else if (console_telnet_state == TELNET_STATE_OPTION) {
            // オプションの番号を受け取れば，交渉のコマンドに応じる
            console_telnet_negotiate(console_telnet_command, b);
            console_telnet_state = TELNET_STATE_DATA;
        } else if (console_telnet_state == TELNET_STATE_SUB) {
            // サブネゴシエーションの中では，IACであれば終わりかを確かめるため次のバイトを待ち，それ以外は読み捨てる
            if (b == TELNET_IAC) {
                console_telnet_state = TELNET_STATE_SUB_IAC;
            }
        } else {
            // サブネゴシエーションの中のIACの直後では，SEであれば終わりとし，それ以外(IACを2つ並べた0xFFなど)は続きとする
            if (b == TELNET_SE) {
                console_telnet_state = TELNET_STATE_DATA;
            } else {
                console_telnet_state = TELNET_STATE_SUB;
            }
        }
    }
}

// TCPの接続から改行までの1行を受け取り，ヌル終端付きで配列へ格納する．受け取った文字のエコーと1行の編集を行う
// - 復帰(CR)か改行(LF)で行を確定し，改行をエコーする．復帰の直後のLF・NULは，同じ改行の一部として読み捨てる
// - BSとDELは，格納した直前の1文字を取り消し，画面から消すエコーを送る(格納した文字が無ければ何もしない)
// - 印字可能な文字とタブを格納してエコーする．配列の要素数-1文字を超える分と，それ以外の文字は捨てる
// - エコーは，エコーのオプションが有効な間だけ行う
// 戻り値: 1(1行を受け取った) / 0(途中で接続が閉じた．配列の内容は不定)
int console_read_line(char *buf, int size) {
    int length = 0;  // 格納した文字数
    int c;           // 受け取った文字の値

    // 行が確定するまで，1文字ずつ受け取って処理する
    while (1) {
        // 1文字受け取る
        c = console_receive_char();
        // 接続が閉じていれば，受け取れない
        if (c < 0) {
            return 0;
        }
        // 復帰の直後のLF・NULは読み捨てる
        if (
            // 直前に受け取った文字が復帰である
            console_after_cr
            // 改行かNULである
            && (c == '\n' || c == '\0')
        ) {
            console_after_cr = 0;
            continue;
        }
        // 次の文字を読み捨てるかの判断に使うため，受け取った文字が復帰かを控える
        console_after_cr = (c == '\r');
        // 復帰か改行であれば，終端して行を確定する
        if (c == '\r' || c == '\n') {
            buf[length] = '\0';
            // 次の出力が次の行から始まるよう，改行をエコーする
            // エコーのオプションが無効な間は，端末が表示するため送らない
            if (console_echo) {
                console_print("\n");
            }
            return 1;
        }
        // BSかDELであれば，直前の1文字を取り消す
        if (c == CONSOLE_BS || c == CONSOLE_DEL) {
            // 格納した文字が無ければ何もしない
            if (length > 0) {
                length--;
                // カーソルを1つ戻し，空白で上書きして，もう1つ戻すことで画面から消す
                // エコーのオプションが無効な間は，端末が表示するため送らない
                if (console_echo) {
                    console_put(CONSOLE_BS);
                    console_put(' ');
                    console_put(CONSOLE_BS);
                }
            }
            continue;
        }
        // 格納する文字かを判定する
        if (
            // 印字可能な文字である
            (c >= ' ' && c < CONSOLE_DEL)
            // タブである
            || c == '\t'
        ) {
            // ヌル終端の分を残して空きがあれば，格納してエコーする
            if (length < size - 1) {
                buf[length] = c;
                length++;
                // エコーのオプションが無効な間は，端末が表示するため送らない
                if (console_echo) {
                    console_put(c);
                }
            }
        }
    }
}
