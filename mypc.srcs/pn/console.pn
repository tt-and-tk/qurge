// シェルと実行ファイルの入出力(以下コンソール．実行ファイルはシステムコールを通してコンソールを使う)を担う関数群
// コンソールは次の2つの端末から成り，1つの画面を2か所で共有する形で使う．コマンドなどの出力は接続している端末すべてへ送り，入力はどちらの端末からも受け付ける
// - telnetで接続した端末: LANを通してtelnet(TCPの接続の上で文字をやり取りする取り決め)で接続した端末．同時に接続できるのは1つ
// - UARTで接続した端末: USBのシリアル通信(UART)で接続した端末．常に使え，受け取ったバイトをそのまま文字として扱う
// 打った文字の表示(エコー)と1行の編集もこのファイルで行う．エコーは，UARTで接続した端末へは常に送り，telnetで接続した端末へは端末側のローカルエコー(打った文字を端末自身が表示する機能)がオフの間だけ送る
//
// telnetでの接続は，次の3つの状態をたどる
// - 待ち受け前: Ethernetモジュール(LANにつなぐための外付けの基板．W5100Sを搭載)に，接続の待ち受けをまだ指示していない．次に接続を確かめるときに待ち受けを始める
// - 待ち受け中: 相手(telnetで接続してくる端末)からの接続を待っている
// - 接続中: 相手と接続している
// telnetで接続した端末への出力は1バイトごとには送らず，TCPの出力バッファ(Qosmosのメモリ上に置く)にためてまとめて送る．送信は1回ごとに完了を待つためである
//
// telnetは，TCPの接続の上で文字をやり取りする取り決めである．送るバイトの大半は文字のデータで，その間に，相手との取り決めや指示を表すコマンドを混ぜる
// コマンドは値0xFFのバイト(IAC)で始まり，続くバイトがコマンドの種類を表す．値0xFFのデータは，IACと区別するため0xFFを2つ並べて送り，受け手は並んだ2バイトを1バイトのデータ0xFFとして受け取る
// コマンドには次の3種類がある(各コマンドの値は，定数の「telnetのコマンドの値」を参照)
// - 交渉のコマンド: IAC，種類を表すバイト，オプションの番号の3バイトで送り，オプションと呼ぶ機能(エコーなど)を使うかを取り決める
//   オプションは，送り手と相手のそれぞれの側で別々に取り決める．送り手自身の側についてはWILL・WONTを，相手の側についてはDO・DONTを使う
//   例えばエコーを行う側を決めるとき，送り手が行うならWILL ECHOを，相手に行わせるならDO ECHOを送る
//   - WILL: 送り手の側でその機能を使うと申し出る(相手のDOへの返事としては，同意を表す)
//   - WONT: 送り手の側でその機能を使わないと伝える(相手のDOへの返事としては，拒否を表す)
//   - DO: 相手の側でその機能を使うよう求める(相手のWILLへの返事としては，同意を表す)
//   - DONT: 相手の側でその機能を使わないよう求める(相手のWILLへの返事としては，拒否を表す)
// - サブネゴシエーション: オプションに付随する内容(端末の種類の名前など)を，長さがオプションによって異なるため始まりと終わりの印で挟んで伝えるコマンドである
//   IACとSB(始まりを表す種類)の2バイト，オプションの番号，内容のバイト列，IACとSE(終わりを表す種類)の2バイトを順に並べたものが，1つのサブネゴシエーションになる
// - そのほかのコマンド: IACと種類を表すバイトの2バイトで送り，処理の中断や応答の確認などの指示を表す
// 例えば，エコーをこちらで行うと申し出るには0xFF 0xFB 0x01(IAC WILL ECHO)を送り，相手は同意すれば0xFF 0xFD 0x01(IAC DO ECHO)を返す
#pragma once
#include "tcp.pn"
#include "network.pn"
#include "uart.pn"

const int CONSOLE_TCP_PORT = 23;          // telnetでの接続を待ち受けるポート番号(telnetの標準のポート番号)
const int CONSOLE_LINE_SIZE = 64;         // コンソールから受け取る1行を置く配列の要素数(ヌル終端の分を含む)
const int CONSOLE_TCP_OUTPUT_SIZE = 256;  // TCPの出力バッファのバイト数
const int CONSOLE_TCP_INPUT_SIZE = 64;    // TCPから受信したデータを置くバッファのバイト数
const int CONSOLE_DECIMAL_SIZE = 12;      // 10進数を出力する一時バッファの要素数(intで最も長い"-2147483648"とヌル終端の分)

// 1行の編集に使う文字コード
const int CONSOLE_BS = 0x08;   // BS(バックスペース)
const int CONSOLE_DEL = 0x7f;  // DEL(バックスペースキーでBSの代わりに送られることがある)

// 端末の種類
const int CONSOLE_TERMINAL_TCP = 0;   // telnetで接続した端末
const int CONSOLE_TERMINAL_UART = 1;  // UARTで接続した端末

// telnetでの接続の状態
const int CONSOLE_TCP_IDLE = 0;       // 待ち受け前
const int CONSOLE_TCP_LISTENING = 1;  // 待ち受け中
const int CONSOLE_TCP_CONNECTED = 2;  // 接続中

// 入力を受け取る関数が，文字の代わりに返す値
const int CONSOLE_NEW_CONNECTION = -1;  // 受け取る前に，新たな端末がtelnetで接続した

// 1行の入力の結果
const int CONSOLE_LINE_DONE = 1;            // 1行を受け取った
const int CONSOLE_LINE_NEW_CONNECTION = 0;  // 受け取る途中で，新たな端末がtelnetで接続した(受け取り途中の行は捨てる)

// telnetのコマンドの値
const unsigned char TELNET_IAC = 0xff;   // IAC(続くバイトがコマンドであることを示す)
const unsigned char TELNET_DONT = 0xfe;  // DONT
const unsigned char TELNET_DO = 0xfd;    // DO
const unsigned char TELNET_WONT = 0xfc;  // WONT
const unsigned char TELNET_WILL = 0xfb;  // WILL
const unsigned char TELNET_SB = 0xfa;    // SB(サブネゴシエーションの始まり)
const unsigned char TELNET_SE = 0xf0;    // SE(サブネゴシエーションの終わり)

// telnetのオプションの番号
const unsigned char TELNET_ECHO = 1;  // エコー(相手が打った文字の表示を，こちらが行う)
const unsigned char TELNET_SGA = 3;   // SGA(Suppress Go Ahead．送り終えるたびに送るGAというコマンドを省き，1文字ずつ送り合えるようにする)

// telnetの受信の状態(受信したバイトをデータとして扱うかコマンドとして扱うかの判断に使う)
const int TELNET_STATE_DATA = 0;     // データを受け取っている
const int TELNET_STATE_COMMAND = 1;  // IACの直後
const int TELNET_STATE_OPTION = 2;   // 交渉のコマンドの直後(オプションの番号を待っている)
const int TELNET_STATE_SUB = 3;      // サブネゴシエーションの中
const int TELNET_STATE_SUB_IAC = 4;  // サブネゴシエーションの中のIACの直後

int console_tcp_state = CONSOLE_TCP_IDLE;                 // telnetでの接続の状態
char console_tcp_output[CONSOLE_TCP_OUTPUT_SIZE];         // TCPの出力バッファ(telnetで接続した端末へ送る出力を，まとめて送るまでためておく)
int console_tcp_output_length = 0;                        // TCPの出力バッファにためたバイト数
char console_last_output = 0;                             // コンソールへ最後に出力した文字(改行の前に復帰を補うかの判断に使う)
char console_tcp_input[CONSOLE_TCP_INPUT_SIZE];           // TCPから受信したデータ
int console_tcp_input_length = 0;                         // 受信したデータのバイト数
int console_tcp_input_position = 0;                       // 受信したデータのうち，次に処理する位置
int console_tcp_after_cr = 0;                             // telnetで接続した端末から直前に受け取った文字が復帰(CR)か(0:違う，1:復帰)
int console_uart_after_cr = 0;                            // UARTで接続した端末から直前に受け取った文字が復帰(CR)か(0:違う，1:復帰)
int console_last_input_terminal = CONSOLE_TERMINAL_UART;  // 直前に受け取った文字を送った端末の種類
int console_telnet_state = TELNET_STATE_DATA;             // telnetの受信の状態
unsigned char console_telnet_command = 0;                 // 受け取った交渉のコマンド(オプションの番号を待つ間に控える)
int console_telnet_echo = 0;                              // エコーのオプションが有効か(0:無効，1:有効．有効な間だけ，打った文字をtelnetで接続した端末へ表示する)
int console_telnet_sga = 0;                               // SGAのオプションが有効か(0:無効，1:有効．GAは有効・無効によらず送らない)

// telnetでの接続を閉じる．TCPの出力バッファの中身と処理する前の受信データは捨てる
void console_tcp_disconnect(void) {
    // 接続を閉じる
    tcp_close();
    // 待ち受け前の状態へ戻す(次に入力を待つときに，待ち受けを始め直す)
    console_tcp_state = CONSOLE_TCP_IDLE;
    // 次の接続へ持ち越さないよう，TCPの出力バッファの中身と受信したデータを捨てる
    console_tcp_output_length = 0;
    console_tcp_input_length = 0;
    console_tcp_input_position = 0;
    console_tcp_after_cr = 0;
    // 受信の区切りをまたいで途中まで受け取ったtelnetのコマンドも捨てる
    console_telnet_state = TELNET_STATE_DATA;
}

// TCPの出力バッファの中身をtelnetでの接続へ送る．送れなければ接続を閉じる
// 送信は1回ごとに完了を待つため，出力のたびに送らず，ためてまとめて送る
void console_tcp_flush(void) {
    int status;  // 送信の結果

    // 送るものが無ければ何もしない
    if (console_tcp_output_length == 0) {
        return;
    }
    // TCPの出力バッファの中身を送る
    status = tcp_send(console_tcp_output, console_tcp_output_length);
    // 送ったものは捨てる
    console_tcp_output_length = 0;
    // 送れなければ相手との接続が切れているため，接続を閉じる
    if (status != TCP_OK) {
        console_tcp_disconnect();
    }
}

// telnetで接続した端末があれば，TCPの出力バッファの末尾に1バイト加え，バッファが満杯になれば送る．接続していなければ捨てる
void console_put_tcp(char c) {
    // 接続が切れた後に加えたバイトを次の接続へ持ち越さないよう，接続していなければ捨てる
    if (console_tcp_state != CONSOLE_TCP_CONNECTED) {
        return;
    }
    // バッファの末尾に加える
    console_tcp_output[console_tcp_output_length] = c;
    console_tcp_output_length++;
    // 満杯になれば送る
    if (console_tcp_output_length == CONSOLE_TCP_OUTPUT_SIZE) {
        console_tcp_flush();
    }
}

// 1文字を両方の端末へ出力する
void console_put(char c) {
    // UARTで接続した端末へ送る
    uart_send(c);
    // TCPの出力バッファに加える
    console_put_tcp(c);
    // 改行の前に復帰を補うかの判断に使うため，出力した文字を控える
    console_last_output = c;
}

// 打った文字を表示するため，1文字を出力する
// UARTで接続した端末へは常に出力し，telnetで接続した端末へはエコーのオプションが有効な間だけ出力する(無効な間は，表示をその端末自身に任せる)
void console_echo(char c) {
    // UARTで接続した端末へ送る
    uart_send(c);
    // エコーのオプションが有効であれば，TCPの出力バッファに加える
    if (console_telnet_echo) {
        console_put_tcp(c);
    }
    // 改行の前に復帰を補うかの判断に使うため，出力した文字を控える
    console_last_output = c;
}

// バイト列を，UARTで接続した端末と，接続中であればtelnetで接続した端末へ出力する(途中で接続が切れた場合，その端末への残りは捨てる)．出力する前に次のように変換する
// - 値0のバイトは出力しない
// - 改行(LF)の直前が復帰(CR)でなければ，復帰を補う(端末が改行だけでは行頭へ戻らないため)
// - telnetで接続した端末へ送る場合は，値0xFFのバイトを2つ並べる(telnetのコマンドの始まりと区別するため)
void console_write(char *data, int length) {
    // 1バイトずつ出力する
    for (int i = 0; i < length; i++) {
        // 値0のバイトは読み飛ばす
        // 値0のバイト(NUL)は，telnetの規格で何もしない文字と定められている．UARTで接続した端末も一般に何も表示しない．このため出力から省く
        // 値0のバイトは，ファイルの内容を出力するコマンドで値0を含むファイルを指定すると渡される
        if (data[i] == '\0') {
            continue;
        }
        // 直前が復帰ではない改行であれば，復帰を補う
        if (
            // 改行である
            data[i] == '\n'
            // 直前に出力した文字が復帰ではない
            && console_last_output != '\r'
        ) {
            console_put('\r');
        }
        // 値0xFFであれば，telnetで接続した端末へは同じ値を先に1つ加える(符号付きのcharでは-1になるため，下位8ビットで比べる)
        if ((data[i] & 0xff) == TELNET_IAC) {
            console_put_tcp(TELNET_IAC);
        }
        // バイトを出力する
        console_put(data[i]);
    }
}

// ヌル終端の文字列をコンソールへ出力する(変換は，バイト列を出力する場合と同じ)
void console_print(char *text) {
    int length = 0;  // 文字列のバイト数

    // ヌル終端までのバイト数を数える
    while (text[length] != '\0') {
        length++;
    }
    // 数えたバイト数を出力する
    console_write(text, length);
}

// valueを符号付きの10進数でコンソールへ出力する(改行は付けない)
void console_print_decimal(int value) {
    char text[CONSOLE_DECIMAL_SIZE];          // 出力する文字列
    char reversed[CONSOLE_DECIMAL_SIZE];      // 数字を下の桁から順に並べたもの
    unsigned int rest = (unsigned int)value;  // まだ数字にしていない上位の桁の値
    int count = 0;                            // reversedに並べた桁数
    int length = 0;                           // textに書いた文字数

    // 負の数は符号を書き，符号なしのまま反転して絶対値にする(intの最小値を符号付きで反転すると桁あふれするため)
    if (value < 0) {
        text[length] = '-';
        length++;
        rest = 0 - rest;
    }
    // 下の桁から1桁ずつ数字にする(値が0でも1桁は出力するため，判定は1桁作った後に行う)
    while (1) {
        reversed[count] = '0' + rest % 10;
        count++;
        rest = rest / 10;
        if (rest == 0) {
            break;
        }
    }
    // 上の桁から順になるよう並べ直す
    while (count > 0) {
        count--;
        text[length] = reversed[count];
        length++;
    }
    // 終端して出力する
    text[length] = '\0';
    console_print(text);
}

// telnetの交渉のコマンドを，オプションの番号を添えてTCPの出力バッファへ加える
// 加えたIACはコマンドの始まりを表すため，データの0xFFのように2つ並べることはしない
void console_telnet_send(unsigned char command, unsigned char option) {
    // IAC，コマンド，オプションの番号の順に加える
    console_put_tcp(TELNET_IAC);
    console_put_tcp(command);
    console_put_tcp(option);
}

// 相手(端末)がtelnetで接続してきたかを確かめる．こちらから接続することはなく，接続してくるのを待たずにすぐ戻る
// telnetでの接続の状態に応じて，次のことを行う
// - 待ち受け前: 待ち受けを始める．始められなければ，Ethernetモジュールが応答する場合にネットワークの設定をやり直す
//   (起動時のネットワークの設定に失敗した場合や，モジュールが待ち受けの状態にならない場合にも，接続を受け付けられるようにするため)
// - 待ち受け中: 相手が接続してきたかを確かめ，接続していれば接続中にして，相手へtelnetのオプションを申し出る
// - 接続中: 何もしない
// 待ち受けを始めた呼び出しでも，続けて接続してきたかを確かめる
// 戻り値: 1(新たに接続した) / 0(既に接続しているか，まだ接続していない)
int console_poll_connection(void) {
    int status;  // TCPの各関数の結果

    // 既に接続していれば何もしない
    if (console_tcp_state == CONSOLE_TCP_CONNECTED) {
        return 0;
    }
    // 待ち受けていなければ，待ち受けを始める
    if (console_tcp_state == CONSOLE_TCP_IDLE) {
        // telnetのポートで待ち受けを始める
        status = tcp_listen(CONSOLE_TCP_PORT);
        // 始められなければ(ネットワークの設定に失敗している場合を含む)，次に確かめるときに待ち受けを始め直す
        if (status != TCP_OK) {
            // モジュールが応答すれば，ネットワークの設定をやり直す
            // やり直すのを応答する間に限るのは，やり直すとモジュールのリセットを待つ間(約64ms)，UARTで接続した端末で打った文字の処理が止まり，モジュールを接続していない間それが続くため
            // やり直しの結果は出力しない．確かめるたびにやり直すため，出力すると同じ行が出続けるため
            if (network_module_responds()) {
                network_setup();
            }
            return 0;
        }
        // 待ち受け中の状態にする
        console_tcp_state = CONSOLE_TCP_LISTENING;
    }
    // 相手が接続したかを確かめる
    status = tcp_accept();
    // まだ接続していなければ，待ち受けを続ける
    if (status == TCP_PENDING) {
        return 0;
    }
    // 確立の途中で相手が中断していれば，次に確かめるときに待ち受けを始め直す
    if (status != TCP_OK) {
        console_tcp_state = CONSOLE_TCP_IDLE;
        return 0;
    }
    // 以降の出力をtelnetで接続した端末へも送る
    console_tcp_state = CONSOLE_TCP_CONNECTED;
    // 新しい接続では，改行の前の復帰を直前の出力によらず補うようにする
    console_last_output = 0;
    // 相手へオプションを申し出る．申し出のバイト列はTCPの出力バッファへ加え，バッファの中身を送るときに一緒に送る
    // 申し出たオプションは，相手が断ればそのときに無効へ戻すため，同意を待たずに有効とする
    // エコーを有効にする
    console_telnet_echo = 1;
    // エコーをこちらで行うと申し出る(相手の端末は，打った文字を自分では表示しなくなる)
    console_telnet_send(TELNET_WILL, TELNET_ECHO);
    // SGAを有効にする
    console_telnet_sga = 1;
    // GAを省くと申し出る(相手の端末は，1文字打つたびに送るようになる)
    console_telnet_send(TELNET_WILL, TELNET_SGA);
    return 1;
}

// telnetでの接続を待ち受け前の状態へ戻す．接続中であれば，TCPの出力バッファの中身を送ってから接続を閉じる
// 待ち受けは，次に接続を確かめるときに始め直される
void console_tcp_close(void) {
    // 接続していれば，TCPの出力バッファの中身を送ってから閉じる
    if (console_tcp_state == CONSOLE_TCP_CONNECTED) {
        // TCPの出力バッファの中身を送る(送れなければ，この中で接続が閉じる)
        console_tcp_flush();
        // まだ接続していれば閉じる
        if (console_tcp_state == CONSOLE_TCP_CONNECTED) {
            console_tcp_disconnect();
        }
    }
    // 待ち受け前の状態にする
    // 待ち受け中のソケットは，次に待ち受けを始めるときに閉じ直すため，ここではモジュールを操作しない
    console_tcp_state = CONSOLE_TCP_IDLE;
}

// telnetでの接続から受信したデータを1バイトだけ，届くのを待たずに取り出す
// 受信したデータをすべて取り出し終えていれば，TCPの出力バッファの中身を送ってから受信し直す
// 戻り値: 取り出したバイトの値(0〜255) / -1(接続していないか，取り出せるバイトが無い)
int console_receive_tcp_byte(void) {
    int status;  // 受信の結果
    int b;       // 取り出したバイトの値

    // 接続していなければ，受け取れない
    if (console_tcp_state != CONSOLE_TCP_CONNECTED) {
        return -1;
    }
    // 受信したデータのバイトをすべて取り出し終えていれば，受信し直す
    // 1回の受信で複数のバイトが届いた場合，残りは受信したデータに置いたまま，次の呼び出しから1バイトずつ取り出す
    if (console_tcp_input_position == console_tcp_input_length) {
        // 相手が待たずに済むよう，受信する前にTCPの出力バッファにためたエコーなどを送る
        console_tcp_flush();
        // 送れずに接続が閉じていれば，受け取れない
        if (console_tcp_state != CONSOLE_TCP_CONNECTED) {
            return -1;
        }
        // 受信したデータを読み出す(届いていなければ0バイトになる)
        status = tcp_recv(console_tcp_input, CONSOLE_TCP_INPUT_SIZE, &console_tcp_input_length);
        // 読み出したデータの先頭から処理する
        console_tcp_input_position = 0;
        // 相手が切断したか接続が切れていれば，接続を閉じる
        if (status != TCP_OK) {
            console_tcp_disconnect();
            return -1;
        }
        // 届いていなければ，取り出せるバイトが無い
        if (console_tcp_input_length == 0) {
            return -1;
        }
    }
    // 次の1バイトを取り出す(符号付きのcharで負になる0x80以上の値を，0〜255として扱う)
    b = console_tcp_input[console_tcp_input_position] & 0xff;
    console_tcp_input_position++;
    return b;
}

// 自分の側のオプションを，相手の要求(DO:有効にする，DONT:無効にする)どおりに切り替え，切り替えたことを応答する
// 既に要求どおりであれば，自分の申し出への同意か重複した要求のため応答しない(応答し合いが続かないようにするため)
void console_telnet_switch(int *enabled, unsigned char command, unsigned char option) {
    int requested = (command == TELNET_DO);  // 要求された状態(0:無効，1:有効)

    // 既に要求どおりであれば何もしない
    if (*enabled == requested) {
        return;
    }
    // 要求どおりに切り替える
    *enabled = requested;
    // 有効にしたならWILL，無効にしたならWONTを応答する
    if (requested) {
        console_telnet_send(TELNET_WILL, option);
    } else {
        console_telnet_send(TELNET_WONT, option);
    }
}

// 相手から受け取った交渉のコマンドに応じて，自分の側のオプションを切り替えるか，要求・申し出を断る
// 相手の同意や拒否には応答しない(応答し合いが続かないようにするため)
void console_telnet_negotiate(unsigned char command, unsigned char option) {
    // 相手が自分の側でオプションを使うと申し出てきた(WILL)ときは，DONTを返してすべて断る
    // 相手の端末は端末の種類や画面の大きさを伝える機能などを申し出てくるが，Qosmosはそれらの値を使わないため
    if (command == TELNET_WILL) {
        console_telnet_send(TELNET_DONT, option);
        return;
    }
    // 相手の側のオプションを無効にする申し出(WONT)には，既に無効のため応答しない
    if (command == TELNET_WONT) {
        return;
    }
    // 自分の側のオプションについての要求(DO・DONT)は，Qosmosが対応するオプションであれば切り替え，それ以外は断る
    if (option == TELNET_ECHO) {
        // エコーを切り替える
        console_telnet_switch(&console_telnet_echo, command, option);
    } else if (option == TELNET_SGA) {
        // SGAを切り替える
        console_telnet_switch(&console_telnet_sga, command, option);
    } else if (command == TELNET_DO) {
        // Qosmosが対応しないオプションを有効にする要求は断る(無効にする要求は，既に無効のため応答を省く)
        console_telnet_send(TELNET_WONT, option);
    }
}

// telnetでの接続から受信した1バイトを，telnetのプロトコルに従って処理する．データであればその文字を返す
// 交渉のコマンドには応答し，それ以外のコマンドは読み捨てる
// 受信の区切りをまたいだコマンドも扱えるよう，どこまで受け取ったかは受信の状態として呼び出しをまたいで控える
// 交渉への応答はTCPの出力バッファへ加わり，次に受信するときにバッファの他の中身と一緒に送られる
// 戻り値: データの文字の値(0〜255) / -1(コマンドの一部として処理した)
int console_telnet_receive(unsigned char b) {
    // 受信の状態に応じて，バイトをデータとして返すか，コマンドの一部として処理して状態を進める
    if (console_telnet_state == TELNET_STATE_DATA) {
        // データの途中では，IACであればコマンドの始まりとして次のバイトを待ち，それ以外はデータの1文字とする
        if (b == TELNET_IAC) {
            console_telnet_state = TELNET_STATE_COMMAND;
            return -1;
        }
        return b;
    } else if (console_telnet_state == TELNET_STATE_COMMAND) {
        // IACの直後では，バイトの値に応じてコマンドを判別する
        if (b == TELNET_IAC) {
            // 0xFFが2つ並んでいれば，1バイトのデータ0xFFとする
            console_telnet_state = TELNET_STATE_DATA;
            return b;
        } else if (b >= TELNET_WILL && b <= TELNET_DONT) {
            // 交渉のコマンド(値が連続するWILL〜DONTの範囲)であれば，応じるのに要るオプションの番号が次のバイトで届くため，番号を受け取るまで待つ
            // 番号を受け取ったときに使うため，受け取ったコマンドを変数に保存する
            console_telnet_command = b;
            // 次のバイトをオプションの番号として扱う
            console_telnet_state = TELNET_STATE_OPTION;
        } else if (b == TELNET_SB) {
            // サブネゴシエーションの始まりであれば，終わりまで読み捨てる
            console_telnet_state = TELNET_STATE_SUB;
        } else {
            // ほかのコマンドはオプションの番号を伴わないため，このバイトだけ読み捨てる
            console_telnet_state = TELNET_STATE_DATA;
        }
    } else if (console_telnet_state == TELNET_STATE_OPTION) {
        // オプションの番号を受け取れば，交渉のコマンドに応じる
        console_telnet_negotiate(console_telnet_command, b);
        console_telnet_state = TELNET_STATE_DATA;
    } else if (console_telnet_state == TELNET_STATE_SUB) {
        // サブネゴシエーションの中では，IACであれば終わりかを確かめるため次のバイトを待ち，それ以外は読み捨てる
        if (b == TELNET_IAC) {
            console_telnet_state = TELNET_STATE_SUB_IAC;
        }
    } else {
        // サブネゴシエーションの中のIACの直後では，SEであれば終わりとし，それ以外(0xFFを2つ並べたデータの0xFFなど)は続きとする
        if (b == TELNET_SE) {
            console_telnet_state = TELNET_STATE_DATA;
        } else {
            console_telnet_state = TELNET_STATE_SUB;
        }
    }
    return -1;
}

// 端末から受け取った文字が，直前の復帰(CR)と組になって改行を表す文字(LF・NUL)として読み捨てるものかを判定する
// 端末は，Enterキーを復帰とLFの2文字か，復帰とNULの2文字で送ることがあるため，2文字目を読み捨てて1つの改行として扱う
// after_crには，その端末から直前に受け取った文字が復帰かを控える変数を渡す(この関数が更新する)
// 戻り値: 1(読み捨てる) / 0(文字として扱う)
int console_skip_after_cr(int *after_cr, int c) {
    // 復帰の直後のLF・NULは読み捨てる
    if (
        // 直前に受け取った文字が復帰である
        *after_cr
        // 改行かNULである
        && (c == '\n' || c == '\0')
    ) {
        *after_cr = 0;
        return 1;
    }
    // 次の文字を読み捨てるかの判断に使うため，受け取った文字が復帰かを控える
    *after_cr = (c == '\r');
    return 0;
}

// どちらかの端末から1文字届くか，新たな端末がtelnetで接続するまで待つ．文字が届けばその文字を，新たに接続すればそのことを返す
// telnetで接続した端末からはtelnetのコマンドを除いたデータを受け取り，どちらの端末からも復帰の直後のLF・NULは読み捨てる
// 文字を受け取ったときは，送った端末の種類も控える
// 戻り値: 受け取った文字の値(0〜255) / CONSOLE_NEW_CONNECTION(新たな端末がtelnetで接続した)
int console_receive_char(void) {
    int b;  // telnetでの接続から受信したバイトの値(0〜255．受信したバイトが無いことを表す-1も入るため，intとする)
    int c;  // 受け取った文字の値(0〜255．文字が無いことを表す-1も入るため，intとする)

    // 文字が得られるまで，両方の端末を交互に確かめる
    while (1) {
        // UARTで接続した端末から受信していれば，その文字を受け取る
        c = uart_receive();
        if (c >= 0) {
            // 読み捨てる文字でなければ，受け取った文字とする
            if (console_skip_after_cr(&console_uart_after_cr, c) == 0) {
                // 送った端末をUARTで接続した端末として控える
                console_last_input_terminal = CONSOLE_TERMINAL_UART;
                // 受け取った文字を返す
                return c;
            }
            continue;
        }
        // 新たな端末がtelnetで接続したかを確かめ，接続していれば伝える
        if (console_poll_connection()) {
            return CONSOLE_NEW_CONNECTION;
        }
        // telnetで接続した端末から受信したバイトを1つ取り出す(無ければ，両方の端末を確かめ直す)
        b = console_receive_tcp_byte();
        if (b < 0) {
            continue;
        }
        // telnetのプロトコルに従って処理し，コマンドの一部であれば次のバイトへ進む
        c = console_telnet_receive(b);
        if (c < 0) {
            continue;
        }
        // 読み捨てる文字でなければ，受け取った文字とする
        if (console_skip_after_cr(&console_tcp_after_cr, c) == 0) {
            // 送った端末をtelnetで接続した端末として控える
            console_last_input_terminal = CONSOLE_TERMINAL_TCP;
            // 受け取った文字を返す
            return c;
        }
    }
}

// コンソールから改行までの1行を受け取るか，新たな端末がtelnetで接続するまで待つ．どちらで待ち終えたかを返す
// 1行を受け取る間は，受け取った文字のエコーと1行の編集を行い，ヌル終端付きで配列へ格納する
// - 復帰(CR)か改行(LF)で行を確定し，改行をエコーする．確定した文字を送った端末を，その行を打った端末として控える
// - BSとDELは，格納した直前の1文字を取り消し，画面から消すエコーを送る(格納した文字が無ければ何もしない)
// - 印字可能な文字とタブを格納してエコーする．配列の要素数-1文字を超える分と，それ以外の文字は捨てる
// 新たな端末がtelnetで接続したときは，受け取り途中の行を捨てる(配列の内容は不定)
// 戻り値: CONSOLE_LINE_DONE(1行を受け取った) / CONSOLE_LINE_NEW_CONNECTION(新たな端末がtelnetで接続した)
int console_read_line(char *buf, int size) {
    int length = 0;  // 格納した文字数
    int c;           // 受け取った文字の値

    // 行が確定するまで，1文字ずつ受け取って処理する
    while (1) {
        // 1文字受け取る
        c = console_receive_char();
        // 新たな端末がtelnetで接続すれば，受け取り途中の行を捨てて伝える
        if (c == CONSOLE_NEW_CONNECTION) {
            return CONSOLE_LINE_NEW_CONNECTION;
        }
        // 復帰か改行であれば，終端して行を確定する
        if (c == '\r' || c == '\n') {
            // 格納した文字の後ろをヌル終端する
            buf[length] = '\0';
            // 次の出力が次の行から始まるよう，復帰と改行をエコーする
            console_echo('\r');
            console_echo('\n');
            // 1行を受け取ったことを伝える
            return CONSOLE_LINE_DONE;
        }
        // BSかDELであれば，直前の1文字を取り消す
        if (c == CONSOLE_BS || c == CONSOLE_DEL) {
            // 格納した文字が無ければ何もしない
            if (length > 0) {
                // 格納した直前の1文字を取り消す
                length--;
                // カーソルを1つ戻し，空白で上書きして，もう1つ戻すことで画面から消す
                console_echo(CONSOLE_BS);
                console_echo(' ');
                console_echo(CONSOLE_BS);
            }
            // 次の文字を受け取る
            continue;
        }
        // 格納する文字かを判定する
        if (
            // 印字可能な文字である
            (c >= ' ' && c < CONSOLE_DEL)
            // タブである
            || c == '\t'
        ) {
            // ヌル終端の分を残して空きがあれば，格納してエコーする
            if (length < size - 1) {
                // 配列の末尾に格納する
                buf[length] = c;
                // 格納した文字数を数える
                length++;
                // 格納した文字をエコーする
                console_echo(c);
            }
        }
    }
}
