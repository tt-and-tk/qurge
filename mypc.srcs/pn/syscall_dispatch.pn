// システムコールの処理．実行ファイルから番号と引数を受け取り，番号に対応するOSの機能(各システムコールの処理)へ振り分ける
// 実行ファイルが渡す番地は領域の中の番地のため，領域に収まるかを確かめてからメモリの番地へ変換して使う
#pragma once
#include "console.pn"
#include "exec_region.pn"
#include "fat.pn"
#include "lib/syscall_number.pn"

// FAT32の各関数が返した失敗を，実行ファイルへ返すエラーの値に変換する
// 実行ファイルへはFAT32の内部の区別を見せず，実行ファイルが対処を変えうる種類だけに分けて返す
int syscall_fat_error(int status) {
    // 失敗の理由ごとに対応する値を返す
    switch (status) {
        case FAT_ERR_TOO_LARGE:
            return SYSCALL_ERR_TOO_LARGE;
        case FAT_ERR_NOT_FOUND:
            return SYSCALL_ERR_NOT_FOUND;
        case FAT_ERR_IS_DIR:
            return SYSCALL_ERR_IS_DIR;
        case FAT_ERR_BAD_NAME:
            return SYSCALL_ERR_BAD_NAME;
        case FAT_ERR_FULL:
            return SYSCALL_ERR_FULL;
    }
    // 残りはマウントしていない・読み書きできない・記録が壊れているなど，SDカードを使えない場合にまとめる(想定外の値も成功と誤解されないようここに含める)
    return SYSCALL_ERR_IO;
}

// 領域の中の番地aにある名前のファイルの大きさ(バイト数)を返す
int syscall_file_size(int a) {
    char *name = exec_region_string(a);  // ファイル名
    struct FatEntry entry;               // 見つかったファイルのエントリ
    int status;                          // 検索の結果

    // 名前が領域の外にあれば探せない
    if (name == nullptr) {
        return SYSCALL_ERR_INVALID;
    }
    // 名前からファイルを探す
    status = fat_find_file(name, &entry);
    if (status != FAT_OK) {
        return syscall_fat_error(status);
    }
    // 負の値はエラーを表すため，intで正の値として表せない大きさは返せない
    if ((int)entry.size < 0) {
        return SYSCALL_ERR_TOO_LARGE;
    }
    return entry.size;
}

// 領域の中の番地aにある名前のファイルの内容を，領域の中の番地bからcバイトの読み込み先へ丸ごと読み込み，そのバイト数を返す
int syscall_file_read(int a, int b, int c) {
    char *name = exec_region_string(a);    // ファイル名
    char *buf = exec_region_buffer(b, c);  // 読み込み先
    int length;                            // 読み込んだバイト数
    int status;                            // 読み込みの結果

    // 名前・読み込み先が領域の外にあれば(読み込み先の大きさが負の場合を含む)読み込めない
    if (name == nullptr || buf == nullptr) {
        return SYSCALL_ERR_INVALID;
    }
    // 内容を丸ごと読み込む
    status = fat_read_file(name, buf, c, &length);
    if (status != FAT_OK) {
        return syscall_fat_error(status);
    }
    return length;
}

// 領域の中の番地aにある名前のファイルの内容を，領域の中の番地bからのcバイトで丸ごと置き換え(無ければ作成し)，0を返す
int syscall_file_write(int a, int b, int c) {
    char *name = exec_region_string(a);     // ファイル名
    char *data = exec_region_buffer(b, c);  // 書き込む内容
    int status;                             // 書き込みの結果

    // 名前・内容が領域の外にあれば(内容のバイト数が負の場合を含む)書き込めない
    if (name == nullptr || data == nullptr) {
        return SYSCALL_ERR_INVALID;
    }
    // 内容を丸ごと置き換える
    status = fat_write_file(name, data, c);
    if (status != FAT_OK) {
        return syscall_fat_error(status);
    }
    return 0;
}

// コンソールから1行を受け取り，領域の中の番地aからのbバイトの格納先へヌル終端付きで格納し，格納した文字数を返す
int syscall_console_read(int a, int b) {
    char *buf = exec_region_buffer(a, b);  // 格納先
    int length = 0;                        // 格納した文字数

    // 格納先が領域の外にあるか，ヌル終端の1バイトも格納できなければ受け取れない
    if (buf == nullptr || b < 1) {
        return SYSCALL_ERR_INVALID;
    }
    // コンソールから，エコーと1行の編集をしながら受け取る
    // 受け取る途中で新たな端末がtelnetで接続すれば，受け取り途中の行を捨てて受け取り直す(新たに接続した相手へOS名を出すのはシェルだけのため，ここでは何も出力しない)
    while (console_read_line(buf, b) == CONSOLE_LINE_NEW_CONNECTION) {
    }
    // 行を確定したときの改行のエコーをtelnetで接続した端末へ送る(送れなければ，この中で接続が閉じる)
    // TCPの出力バッファの中身は，シェルが次に入力を待つまで送られない
    // ここで送らないと，実行ファイルが受け取った後に長く計算する間，相手の端末のカーソルが入力した行の末尾に残る
    console_tcp_flush();
    // ヌル終端までの文字数を数える
    while (buf[length] != '\0') {
        length++;
    }
    return length;
}

// 領域の中の番地aからのbバイトをコンソールへ出力し，0を返す
int syscall_console_write(int a, int b) {
    char *data = exec_region_buffer(a, b);  // 出力するバイト列

    // バイト列が領域の外にあるか，出力するバイトが1つも無ければ出力できない
    if (data == nullptr || b < 1) {
        return SYSCALL_ERR_INVALID;
    }
    // コンソールへ出力する
    // telnetでの接続が切れたことは送るときに分かり，そのときまでにためていたtelnetで接続した端末への出力と，分かった後のtelnetで接続した端末への出力は失われる
    console_write(data, b);
    // TCPの出力バッファの中身をtelnetで接続した端末へ送る(送れなければ，この中で接続が閉じる)
    // TCPの出力バッファの中身はシェルが次に入力を待つまで送られないため，実行ファイルが出力の後に長く計算すると表示が遅れる
    console_tcp_flush();
    return 0;
}

// 番号numberのシステムコールの処理を引数a〜dで実行し，その結果を返す(戻り値: 0以上は成功，負の値はエラー)
// コンソールへ出すのは，実行ファイルが出力を求めたバイト列と，1行を受け取る間のエコーだけである(エラーを表示するかどうかは，呼び出した実行ファイルが決めるため)
int syscall_dispatch(int number, int a, int b, int c, int d) {
    // 番号に対応する機能を実行する
    switch (number) {
        // ファイルの大きさを返す
        case SYS_FILE_SIZE:
            return syscall_file_size(a);
        // ファイルの内容を丸ごと読み込む
        case SYS_FILE_READ:
            return syscall_file_read(a, b, c);
        // ファイルの内容を丸ごと書き込む
        case SYS_FILE_WRITE:
            return syscall_file_write(a, b, c);
        // コンソールから1行を受け取る
        case SYS_CONSOLE_READ:
            return syscall_console_read(a, b);
        // コンソールへ出力する
        case SYS_CONSOLE_WRITE:
            return syscall_console_write(a, b);
    }
    // どの番号とも一致しなければ，未定義の番号としてエラーを返す
    return SYSCALL_ERR_UNKNOWN;
}

// 実行ファイルがシステムコールの命令を実行した時点のSP(領域の中の番地user_sp)から並べた番号と引数を読み，番号に対応する機能を実行して，戻り値を置き場へ書き込む
// 戻り値: 実行ファイルが終了を求めた場合は1(終了状態をexit_statusへ書き込む)，それ以外は0
// SPが4の倍数でないか，並べた値が領域に収まらなければ，何もせず0を返す(値を読めず，戻り値も書き込めないため)
int syscall_handle(unsigned int user_sp, int *exit_status) {
    int *args = (int *)exec_region_buffer((int)user_sp, SYSCALL_ARGS_SIZE);  // SPから並べた値

    // 並べた値を読めなければ，何もしない
    if (
        // 並べた値が領域に収まらない
        args == nullptr
        // または，SPが4の倍数でない(4バイトの値がワードをまたぎ，正しく読み書きできないため)
        || (user_sp & 3) != 0) {
        return 0;
    }
    // 終了を求めていれば，終了状態を控えて終了を伝える
    if (args[SYSCALL_ARG_NUMBER] == SYS_EXIT) {
        *exit_status = args[SYSCALL_ARG_A];
        return 1;
    }
    // 番号に対応する機能を実行し，戻り値を置き場へ書き込む
    args[SYSCALL_ARG_RESULT] = syscall_dispatch(args[SYSCALL_ARG_NUMBER], args[SYSCALL_ARG_A], args[SYSCALL_ARG_B],
                                                args[SYSCALL_ARG_C], args[SYSCALL_ARG_D]);
    return 0;
}
