// システムコールの受付関数．実行ファイルから番号と引数を受け取り，番号に対応するOSの機能(各システムコールの処理)へ振り分ける
// シェルは実行ファイルを呼び出す直前に，この関数の番地をシステムコールの入口へ書き込む
#pragma once
#include "console.pn"
#include "fat.pn"
#include "lib/syscall_number.pn"

char syscall_line[CONSOLE_LINE_SIZE];  // PSを経由して受け取った1行(組み込み関数scanは配列変数のみ受け付けるため，格納先へ直接は読み込まない)

// FAT32の各関数が返した失敗を，実行ファイルへ返すエラーの値に変換する
// 実行ファイルへはFAT32の内部の区別を見せず，実行ファイルが対処を変えうる種類だけに分けて返す
int syscall_fat_error(int status) {
    // 失敗の理由ごとに対応する値を返す
    switch (status) {
        case FAT_ERR_TOO_LARGE:
            return SYSCALL_ERR_TOO_LARGE;
        case FAT_ERR_NOT_FOUND:
            return SYSCALL_ERR_NOT_FOUND;
        case FAT_ERR_IS_DIR:
            return SYSCALL_ERR_IS_DIR;
        case FAT_ERR_BAD_NAME:
            return SYSCALL_ERR_BAD_NAME;
        case FAT_ERR_FULL:
            return SYSCALL_ERR_FULL;
    }
    // 残りはマウントしていない・読み書きできない・記録が壊れているなど，SDカードを使えない場合にまとめる(想定外の値も成功と誤解されないようここに含める)
    return SYSCALL_ERR_IO;
}

// 名前aのファイルの大きさ(バイト数)を返す
int syscall_file_size(int a) {
    char *name = (char *)a;  // ファイル名
    struct FatEntry entry;   // 見つかったファイルのエントリ
    int status;              // 検索の結果

    // 名前を読めなければ探せない
    if (name == nullptr) {
        return SYSCALL_ERR_INVALID;
    }
    // 名前からファイルを探す
    status = fat_find_file(name, &entry);
    if (status != FAT_OK) {
        return syscall_fat_error(status);
    }
    // 負の値はエラーを表すため，intで正の値として表せない大きさは返せない
    if ((int)entry.size < 0) {
        return SYSCALL_ERR_TOO_LARGE;
    }
    return entry.size;
}

// 名前aのファイルの内容を，番地bからcバイトの読み込み先へ丸ごと読み込み，そのバイト数を返す
int syscall_file_read(int a, int b, int c) {
    char *name = (char *)a;  // ファイル名
    char *buf = (char *)b;   // 読み込み先
    int length;              // 読み込んだバイト数
    int status;              // 読み込みの結果

    // 名前・読み込み先を読み書きできないか，読み込み先の大きさが負であれば読み込めない
    if (name == nullptr || buf == nullptr || c < 0) {
        return SYSCALL_ERR_INVALID;
    }
    // 内容を丸ごと読み込む
    status = fat_read_file(name, buf, c, &length);
    if (status != FAT_OK) {
        return syscall_fat_error(status);
    }
    return length;
}

// 名前aのファイルの内容を，番地bからのcバイトで丸ごと置き換え(無ければ作成し)，0を返す
int syscall_file_write(int a, int b, int c) {
    char *name = (char *)a;  // ファイル名
    char *data = (char *)b;  // 書き込む内容
    int status;              // 書き込みの結果

    // 名前・内容を読めないか，内容のバイト数が負であれば書き込めない
    if (name == nullptr || data == nullptr || c < 0) {
        return SYSCALL_ERR_INVALID;
    }
    // 内容を丸ごと置き換える
    status = fat_write_file(name, data, c);
    if (status != FAT_OK) {
        return syscall_fat_error(status);
    }
    return 0;
}

// コンソールから1行を受け取り，番地aからのbバイトの格納先へヌル終端付きで格納し，格納した文字数を返す
int syscall_console_read(int a, int b) {
    char *buf = (char *)a;  // 格納先
    int length = 0;         // 格納した文字数

    // 格納先を書き込めないか，ヌル終端の1バイトも格納できなければ受け取れない
    if (buf == nullptr || b < 1) {
        return SYSCALL_ERR_INVALID;
    }
    // TCPで接続していればその接続から，していなければPSから1行受け取る
    if (console_connected) {
        // エコーと1行の編集をしながら受け取る
        if (console_read_line(buf, b) == 0) {
            // 途中で接続が閉じれば，受け取れない
            return SYSCALL_ERR_DISCONNECTED;
        }
        // 行を確定したときの改行のエコーを送る(送れなければ，この中で接続が閉じる)
        // ためた出力は，シェルが次に入力を待つまで送られない
        // ここで送らないと，実行ファイルが受け取った後に長く計算する間，相手の端末のカーソルが入力した行の末尾に残る
        console_flush();
    } else {
        // PSから1行読み込む
        scan(syscall_line);
        // 格納先の大きさからヌル終端の分を除いた文字数まで写し，入りきらない分は捨てる
        while (length < b - 1 && syscall_line[length] != '\0') {
            buf[length] = syscall_line[length];
            length++;
        }
        // 写した文字列を終端する
        buf[length] = '\0';
    }
    // ヌル終端までの文字数を数える
    length = 0;
    while (buf[length] != '\0') {
        length++;
    }
    return length;
}

// 番地aからのbバイトをコンソールへ出力し，0を返す
int syscall_console_write(int a, int b) {
    char *data = (char *)a;  // 出力するバイト列

    // バイト列を読めないか，出力するバイトが1つも無ければ出力できない
    if (data == nullptr || b < 1) {
        return SYSCALL_ERR_INVALID;
    }
    // コンソールへ出力する
    // TCPの接続が切れたことは送るときに分かり，そのときまでにためていた出力は失われる．分かった後の出力はPSへ出る
    console_write(data, b);
    // ためた出力を送る(送れなければ，この中で接続が閉じる)
    // ためた出力はシェルが次に入力を待つまで送られないため，実行ファイルが出力の後に長く計算すると表示が遅れる
    console_flush();
    return 0;
}

// 番号numberのシステムコールの処理を引数a〜dで実行し，その結果を返す(戻り値: 0以上は成功，負の値はエラー)
// コンソールへ出すのは，実行ファイルが出力を求めたバイト列と，1行を受け取る間のエコーだけである(エラーを表示するかどうかは，呼び出した実行ファイルが決めるため)
int syscall_dispatch(int number, int a, int b, int c, int d) {
    // 番号に対応する機能を実行する
    switch (number) {
        // ファイルの大きさを返す
        case SYS_FILE_SIZE:
            return syscall_file_size(a);
        // ファイルの内容を丸ごと読み込む
        case SYS_FILE_READ:
            return syscall_file_read(a, b, c);
        // ファイルの内容を丸ごと書き込む
        case SYS_FILE_WRITE:
            return syscall_file_write(a, b, c);
        // コンソールから1行を受け取る
        case SYS_CONSOLE_READ:
            return syscall_console_read(a, b);
        // コンソールへ出力する
        case SYS_CONSOLE_WRITE:
            return syscall_console_write(a, b);
    }
    // どの番号とも一致しなければ，未定義の番号としてエラーを返す
    return SYSCALL_ERR_UNKNOWN;
}
