// シェルのメインループ．標準入力から1行受け取り，先頭のトークンをコマンド名として解析し，対応する処理を呼び出す
char input[64];  // 1行分の入力バッファ
char cmd[64];    // 入力の先頭トークン(コマンド名)

// ファイル1件分のエントリ(名前は7文字+ヌル終端，内容は31文字+ヌル終端)
struct FileEntry {
    char name[8];
    char content[32];
};

struct FileEntry entries[4];  // ファイルテーブル本体(最大4件)
char file_used[4];            // 各エントリの使用中フラグ(0:未使用，1:使用中)

// bufのpos文字目以降に連続する空白を読み飛ばした位置を返す
// 引数の区切りの規則をここに集め，引数の取り出しと残数の確認とで食い違わないようにする
int skip_spaces(char buf[], int pos) {
    while (buf[pos] == ' ') {
        pos = pos + 1;
    }
    return pos;
}

// bufのpos文字目以降で先頭の連続する空白を読み飛ばし，次の空白かヌル終端の直前までをargへコピーする
// 戻り値は取り出した引数の直後の位置であり，これを次の呼び出しのposへ渡して引数を順に取り出す
// 引数が残っていなければargは空文字列になる
// argは1つの引数が行全体になり得るため，inputと同じ幅で確保する(コピー量を制限する手段を持たない)
int extract_arg(char buf[], int pos, char arg[]) {
    int i = 0;
    pos = skip_spaces(buf, pos);
    while (buf[pos + i] != ' ' && buf[pos + i] != '\0') {
        arg[i] = buf[pos + i];
        i = i + 1;
    }
    arg[i] = '\0';
    return pos + i;
}

// bufのpos文字目以降を丸ごと1つの引数としてargへコピーする(前後の空白は取り除き，途中の空白はそのまま残す)
// 空白を区切りとして扱わない自由テキスト(echoの出力内容・writeの書き込み内容)専用の取り出し方
// argはextract_argと同じく，行全体を受け取れるようinputと同じ幅で確保する
void extract_text_arg(char buf[], int pos, char arg[]) {
    int i = 0;    // bufから読み出した文字数
    int len = 0;  // 末尾の空白を除いたargの長さ
    pos = skip_spaces(buf, pos);
    while (buf[pos + i] != '\0') {
        arg[i] = buf[pos + i];
        if (buf[pos + i] != ' ') {
            len = i + 1;  // 空白以外を書いた位置までを長さとし，末尾に続く空白を切り捨てる
        }
        i = i + 1;
    }
    arg[len] = '\0';
}

// bufのpos文字目以降に引数が残っていれば1，残っていなければ0を返す
// (extract_argで取り出して空文字列か調べる形にすると，捨てるためだけのバッファをinputと同じ幅で用意することになる)
int has_extra_args(char buf[], int pos) {
    pos = skip_spaces(buf, pos);
    return buf[pos] != '\0';
}

// エラーは"<コマンド名>: <内容>"の形式で出力する．接頭辞をここに集め，内容は呼び出し側が続けて出力する
// (printは直接配列のみを受け付け配列パラメータを渡せないため，内容を引数として渡すことはできない)
void error_prefix(void) {
    print(cmd);
    print(": ");
}

// 複数のコマンドが出す内容は関数として置き，同じ文言をコマンドの数だけ持たないようにする
void error_missing_arg(void) {
    error_prefix();
    print("missing argument\n");
}

void error_too_many_args(void) {
    error_prefix();
    print("too many arguments\n");
}

void error_no_such_file(void) {
    error_prefix();
    print("no such file\n");
}

// 引数をちょうど1つだけ取るコマンドの共通処理: 引数をnameへ取り出し，取り出せれば1を返す
// 引数が無いか2つ以上あれば，エラーを出力して0を返す
int extract_single_arg(int pos, char name[]) {
    pos = extract_arg(input, pos, name);
    if (name[0] == '\0') {
        error_missing_arg();
        return 0;
    }
    if (has_extra_args(input, pos)) {
        error_too_many_args();
        return 0;
    }
    return 1;
}

// echoコマンド: 引数をそのまま出力する(引数を持たない場合は空行を出力する)
void handle_echo(int pos) {
    char text[64];  // 出力する内容
    extract_text_arg(input, pos, text);
    print(text);
    print("\n");
}

// file_usedを先頭から走査し，未使用エントリのインデックスを返す．空きが無ければ-1を返す
int find_free_entry(void) {
    for (int i = 0; i < 4; i++) {
        if (file_used[i] == 0) {
            return i;
        }
    }
    return -1;
}

// nameの先頭7文字(ヌル終端が先に来ればそこまで)をtruncatedへコピーし，ヌル終端する
// (保存側のrename_fileも同じ7文字の打ち切りを自前で持つ．コピー先がentries[].nameであり，構造体配列のメンバを関数へ渡せないためこの関数を呼べない)
void truncate_name(char name[], char truncated[]) {
    int i = 0;
    while (name[i] != '\0' && i < 7) {
        truncated[i] = name[i];
        i = i + 1;
    }
    truncated[i] = '\0';
}

// nameの内容をentries[entry].nameへ1文字ずつコピーする(7文字を超える分は切り捨てる)
void rename_file(int entry, char name[]) {
    int i = 0;
    while (name[i] != '\0' && i < 7) {
        entries[entry].name[i] = name[i];
        i = i + 1;
    }
    entries[entry].name[i] = '\0';
}

// entries[entry].nameをnameの先頭7文字で設定し，内容を空にしたうえで使用中フラグを立てる
void create_file(int entry, char name[]) {
    rename_file(entry, name);
    entries[entry].content[0] = '\0';
    file_used[entry] = 1;
}

// contentの内容をentries[entry].contentへ1文字ずつコピーする(31文字を超える分は切り捨てる)
void write_file(int entry, char content[]) {
    int i = 0;
    while (content[i] != '\0' && i < 31) {
        entries[entry].content[i] = content[i];
        i = i + 1;
    }
    entries[entry].content[i] = '\0';
}

// nameとentries[entry].nameが一致するか比較する(streqは構造体配列のメンバを渡せないため手動比較する)
int names_match(char name[], int entry) {
    int j = 0;
    while (j < 8) {
        if (name[j] != entries[entry].name[j]) {
            return 0;
        }
        if (entries[entry].name[j] == '\0') {
            // 同じ位置でヌル終端に達した(一致)
            return 1;
        }
        j = j + 1;
    }
    // 保存名も検索名(find_entry_by_nameが切り詰める)も7文字以内でヌル終端されるためここへは到達しないが，値を返さない経路を作らないために一致として返す
    return 1;
}

// nameと一致する使用中エントリのインデックスを返す．無ければ-1を返す(保存名は7文字に切り詰められているため，検索名も同じ規則で切り詰めてから照合する)
int find_entry_by_name(char name[]) {
    char truncated[8];  // nameを7文字に切り詰めた検索名
    truncate_name(name, truncated);
    for (int i = 0; i < 4; i++) {
        if (file_used[i] == 1 && names_match(truncated, i)) {
            return i;
        }
    }
    return -1;
}

// entryの使用中フラグを下ろし，未使用エントリとして扱えるようにする(nameやcontentのクリアは行わない．再利用時にcreate_fileが上書きするため)
void delete_file(int entry) {
    file_used[entry] = 0;
}

// entries[entry].nameを一時バッファへ1文字ずつコピーしてから出力する(printは直接配列のみ受け付けるため)
void print_entry(int entry) {
    char entry_buf[8];  // 出力用の一時バッファ(entries[].nameと同じ幅)
    int i = 0;
    while (entries[entry].name[i] != '\0') {
        entry_buf[i] = entries[entry].name[i];
        i = i + 1;
    }
    entry_buf[i] = '\0';
    print(entry_buf);
    print("\n");
}

// lsコマンド: 使用中の全エントリの名前を順に出力する
void handle_ls(int pos) {
    if (has_extra_args(input, pos)) {
        error_too_many_args();
        return;
    }
    for (int i = 0; i < 4; i++) {
        if (file_used[i] == 1) {
            print_entry(i);
        }
    }
}

// entries[entry].contentを一時バッファへ1文字ずつコピーしてから出力する(printは直接配列のみ受け付けるため)
void print_content(int entry) {
    char content_buf[32];  // 出力用の一時バッファ(entries[].contentと同じ幅)
    int i = 0;
    while (entries[entry].content[i] != '\0') {
        content_buf[i] = entries[entry].content[i];
        i = i + 1;
    }
    content_buf[i] = '\0';
    print(content_buf);
    print("\n");
}

// touchコマンド: 引数のファイル名で空のファイルを1件作成する(既に同名のファイルがあれば作成しない)
void handle_touch(int pos) {
    char name[64];  // 作成するファイル名
    int entry;      // 割り当てたエントリのインデックス

    if (extract_single_arg(pos, name) == 0) {
        return;
    }

    if (find_entry_by_name(name) != -1) {  // 既に同名のファイルがあれば作成しない
        error_prefix();
        print("file already exists\n");
        return;
    }
    entry = find_free_entry();
    if (entry != -1) {
        create_file(entry, name);
    } else {
        error_prefix();
        print("no free entry\n");
    }
}

// writeコマンド: 第1引数のファイルの内容を，第2引数の内容で丸ごと上書きする
void handle_write(int pos) {
    char name[64];     // 書き込み先のファイル名
    char content[64];  // 書き込む内容
    int entry;         // 対象エントリのインデックス

    pos = extract_arg(input, pos, name);
    if (name[0] == '\0') {
        error_missing_arg();
        return;
    }
    // 内容は空白を区切りとしない自由テキストであり，行末までが1つの引数になる
    // (内容が空の場合はファイルを空にする指示として扱うため，引数不足とはしない)
    extract_text_arg(input, pos, content);

    entry = find_entry_by_name(name);
    if (entry == -1) {  // 対象ファイルが無ければ何もしない(自動作成はしない)
        error_no_such_file();
        return;
    }
    write_file(entry, content);
}

// 既存のファイル名だけを引数に取るコマンドの共通処理: 引数を検証し，対象エントリのインデックスを返す
// 引数の個数が違うか対象のファイルが無ければ，エラーを出力して-1を返す
int resolve_file_arg(int pos) {
    char name[64];  // 対象のファイル名
    int entry;      // 対象エントリのインデックス

    if (extract_single_arg(pos, name) == 0) {
        return -1;
    }

    entry = find_entry_by_name(name);
    if (entry == -1) {
        error_no_such_file();
    }
    return entry;
}

// catコマンド: 引数のファイル名に対応する内容を出力する
void handle_cat(int pos) {
    int entry;  // 対象エントリのインデックス
    entry = resolve_file_arg(pos);
    if (entry != -1) {
        print_content(entry);
    }
}

// rmコマンド: 引数のファイル名に対応するエントリを削除する
void handle_rm(int pos) {
    int entry;  // 対象エントリのインデックス
    entry = resolve_file_arg(pos);
    if (entry != -1) {
        delete_file(entry);
    }
}

// mvコマンド: 第1引数のファイルの名前を，第2引数の名前へ変更する
void handle_mv(int pos) {
    char old_name[64];  // 旧ファイル名
    char new_name[64];  // 新ファイル名
    int entry;          // 対象エントリのインデックス

    pos = extract_arg(input, pos, old_name);
    pos = extract_arg(input, pos, new_name);
    if (old_name[0] == '\0' || new_name[0] == '\0') {
        error_missing_arg();
        return;
    }
    if (has_extra_args(input, pos)) {
        error_too_many_args();
        return;
    }

    entry = find_entry_by_name(old_name);
    if (entry == -1) {
        error_no_such_file();
        return;
    }
    rename_file(entry, new_name);
}

// helpコマンド: 利用可能なコマンドの一覧を表示する
void handle_help(int pos) {
    if (has_extra_args(input, pos)) {
        error_too_many_args();
        return;
    }
    print("echo\n");
    print("help\n");
    print("ls\n");
    print("touch\n");
    print("write\n");
    print("cat\n");
    print("rm\n");
    print("mv\n");
}

// 未対応コマンドのエラーメッセージを表示する(何が未対応だったかが分かるよう入力されたコマンド名を出す)
void handle_unknown(void) {
    error_prefix();
    print("unknown command\n");
}

// グローバル配列cmdの内容に応じた処理を呼び出す(streqは直接配列のみ受け付けるため，パラメータではなくグローバル配列を直接比較する)
// 引数の個数と種類はコマンドごとに異なるため，引数の取り出しと検証は各handle_*が自分で行う
void dispatch(int pos) {
    if (streq(cmd, "echo")) {
        handle_echo(pos);
    } else if (streq(cmd, "help")) {
        handle_help(pos);
    } else if (streq(cmd, "ls")) {
        handle_ls(pos);
    } else if (streq(cmd, "touch")) {
        handle_touch(pos);
    } else if (streq(cmd, "write")) {
        handle_write(pos);
    } else if (streq(cmd, "cat")) {
        handle_cat(pos);
    } else if (streq(cmd, "rm")) {
        handle_rm(pos);
    } else if (streq(cmd, "mv")) {
        handle_mv(pos);
    } else {
        handle_unknown();
    }
}

void main(void) {
    int pos;  // コマンド名の直後の位置(引数の取り出し開始位置)
    for (int i = 0; i < 4; i++) {  // グローバル配列の初期値は不定なため，起動時に明示的にクリアする
        file_used[i] = 0;
    }
    while (1) {
        print("> ");  // 入力待ちであることを示すプロンプト
        scan(input);
        pos = extract_arg(input, 0, cmd);
        dispatch(pos);
    }
}
