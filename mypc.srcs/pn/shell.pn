// シェルのメインループ．標準入力から1行受け取り，先頭のトークンをコマンド名として解析し，対応する処理を呼び出す
#include "args.pn"
#include "sd.pn"
#include "fat.pn"

const int INPUT_SIZE = 64;          // 1行分の入力バッファの要素数(引数を取り出す配列も同じ幅で確保し，打ち切りを起こさない)
const int ERROR_MESSAGE_SIZE = 32;  // エラーメッセージを出力する一時バッファの要素数
const int MOUNT_ERR_INIT = -1;      // mount_cardの戻り値: カードを初期化できなかった(FAT32の各関数の戻り値と重ならない値)

char input[INPUT_SIZE];  // 1行分の入力バッファ
char cmd[INPUT_SIZE];    // 入力の先頭トークン(コマンド名)

// エラーメッセージの前置き"<コマンド名>: "を出力する(どのコマンドが出したエラーかが分かるようにするため)
void print_error_head(void) {
    print(cmd);
    print(": ");
}

// エラーを"<コマンド名>: <msg>"の形式で出力する(msgは末尾の改行まで含めて渡す)
void print_error(char *msg) {
    char msg_buf[ERROR_MESSAGE_SIZE];  // 出力用の一時バッファ(printは配列変数のみ受け付けるため)
    int i = 0;
    while (msg[i] != '\0' && i < ERROR_MESSAGE_SIZE - 1) {
        msg_buf[i] = msg[i];
        i = i + 1;
    }
    msg_buf[i] = '\0';
    print_error_head();
    print(msg_buf);
}

// FAT32の各関数やmount_cardが返した失敗の理由を，改行付きのメッセージとして出力する
void print_fat_message(int status) {
    switch (status) {
    case MOUNT_ERR_INIT:
        print("initialization failed\n");
        break;
    case FAT_ERR_READ:
        print("cannot read card\n");
        break;
    case FAT_ERR_NOT_FAT32:
        print("no FAT32 volume\n");
        break;
    case FAT_ERR_BROKEN:
        print("broken file system\n");
        break;
    case FAT_ERR_NOT_MOUNTED:
        print("no volume mounted\n");
        break;
    case FAT_ERR_BAD_NAME:
        print("invalid file name\n");
        break;
    case FAT_ERR_NOT_FOUND:
        print("no such file\n");
        break;
    case FAT_ERR_IS_DIR:
        print("is a directory\n");
        break;
    default:
        print("unexpected error\n");
        break;
    }
}

// FAT32の各関数やmount_cardが返した失敗を，実行中のコマンドのエラーとして出力する
void print_fat_error(int status) {
    print_error_head();
    print_fat_message(status);
}

// echoコマンド: コマンド名以降の引数部分をそのまま出力する
void handle_echo(int pos) {
    char args[INPUT_SIZE];  // コマンド名を除いた引数部分
    extract_text_arg(input, pos, args, INPUT_SIZE);
    print(args);
    print("\n");
}

// ルートディレクトリの走査で，エントリの名前を1行出力する(ディレクトリは末尾に'/'を付けて区別する)
int print_entry(struct FatEntry *entry) {
    char text[FAT_NAME_TEXT_SIZE];  // 表示用の名前
    fat_format_name(entry, text);
    print(text);
    if ((entry->attr & ATTR_DIRECTORY) != 0) {
        print("/");
    }
    print("\n");
    // 全エントリを出力するため，走査は打ち切らない
    return 0;
}

// lsコマンド: ルートディレクトリにあるファイル・ディレクトリの名前を順に出力する
void handle_ls(int pos) {
    int status;  // 走査の結果

    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    status = fat_walk_root(print_entry);
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// catコマンド: 引数のファイル名に対応するファイルの内容を出力する
void handle_cat(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(読み出すファイル名)
    struct FatEntry entry;  // 見つかったファイルのエントリ
    struct FatFile file;    // 読み出し中のファイルの位置
    int length;             // 読み込んだセクタのうち内容にあたるバイト数
    int status;             // FAT32の各関数の結果
    int last = '\n';        // 最後に出力した文字(内容が改行で終わらなければ改行を補うため．空のファイルでは補わないよう改行から始める)

    // コマンド名(cat)の直後の引数をファイル名として取り出す
    pos = extract_arg(input, pos, name, INPUT_SIZE);
    // ファイル名が指定されていなければ何もしない
    if (name[0] == '\0') {
        print_error("missing argument\n");
        return;
    }
    // ファイル名の後に余分な引数があれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }

    // ファイル名から対象のエントリを探して開く
    status = fat_find(name, &entry);
    if (status == FAT_OK) {
        status = fat_open(&entry, &file);
    }
    if (status != FAT_OK) {
        print_fat_error(status);
        return;
    }

    // 1セクタずつ読み込んで出力する
    while (1) {
        status = fat_read(&file, &length);
        if (status == FAT_END) {
            break;
        }
        if (status != FAT_OK) {
            // 途中まで出力した内容とエラーメッセージが同じ行に並ばないよう改行を挟む
            if (last != '\n') {
                print("\n");
            }
            print_fat_error(status);
            return;
        }
        last = fat_sector[length - 1];
        // printはヌル終端か配列の終わりまでを出力するため，内容がセクタの途中で終わる場合だけ終端を置く
        if (length < SD_BLOCK_SIZE) {
            fat_sector[length] = '\0';
        }
        print(fat_sector);
    }
    if (last != '\n') {
        print("\n");
    }
}

// SDカードを初期化し，カード上のFAT32ボリュームをマウントする
// 失敗した場合の表示は，起動時と実行中のコマンドとで前置きが異なるため呼び出し元に任せる
// 戻り値: FAT_OK / MOUNT_ERR_INIT / fat_mountの失敗
int mount_card(void) {
    // 初期化に失敗したときに前のカードのボリュームを読まないよう，先に外しておく
    fat_unmount();
    // 途中経過はsd_initが表示する
    if (sd_init() == 0) {
        return MOUNT_ERR_INIT;
    }
    return fat_mount();
}

// sdinitコマンド: SDカードを初期化し，カード上のFAT32ボリュームをマウントし直す
void handle_sdinit(int pos) {
    int status;  // マウントの結果

    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    status = mount_card();
    if (status != FAT_OK) {
        print_fat_error(status);
        return;
    }
    print("volume mounted\n");
}

// helpコマンド: 利用可能なコマンドの一覧を表示する
void handle_help(int pos) {
    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    print("echo\n");
    print("help\n");
    print("ls\n");
    print("cat\n");
    print("sdinit\n");
}

// 未対応コマンドのエラーメッセージを表示する
void handle_unknown(void) {
    // 未対応である旨のエラーを出力する
    print_error("unknown command\n");
}

// グローバル配列cmdの内容に応じた処理を呼び出す(streqは配列変数のみ受け付けるため，パラメータではなくグローバル配列を直接比較する)
// 引数の取り出し対象は1行分の入力を保持するinputで固定のため，コマンド側へは位置だけを渡す
void dispatch(int pos) {
    if (streq(cmd, "echo")) {
        handle_echo(pos);
    } else if (streq(cmd, "help")) {
        handle_help(pos);
    } else if (streq(cmd, "ls")) {
        handle_ls(pos);
    } else if (streq(cmd, "cat")) {
        handle_cat(pos);
    } else if (streq(cmd, "sdinit")) {
        handle_sdinit(pos);
    } else {
        handle_unknown();
    }
}

void main(void) {
    int pos;     // コマンド名の直後の位置(引数の取り出し開始位置)
    int status;  // 起動時のマウントの結果

    // カードがあればボリュームをマウントする．失敗してもsdinitでやり直せるよう，シェルはそのまま起動する
    // 表示にprint_errorを使わないのは，この時点ではコマンド名が入っていないため
    status = mount_card();
    if (status == FAT_OK) {
        print("fat: volume mounted\n");
    } else {
        print("fat: ");
        print_fat_message(status);
    }
    while (1) {
        print("> ");  // 入力待ちであることを示すプロンプト
        scan(input);
        pos = extract_arg(input, 0, cmd, INPUT_SIZE);
        dispatch(pos);
    }
}
