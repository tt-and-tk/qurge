// プロセステーブルと，実行中のプロセスの領域の中の番地をメモリの番地へ変換する関数
// プロセスごとに，プロセス用の範囲のうちどのプロセスにも割り振っていない範囲(以下，空き)から，必要な大きさの範囲(以下，領域)を割り振る
// プロセスは，領域の先頭を0とするバイト単位の番地(以下，領域の中の番地)でユーザーモードとして動く
// 領域の中の番地は，命令の取り出しとメモリの読み書きのたびにCPUがメモリの番地へ変換する．カーネルモードで動くOSは変換されないため，変換する関数もここに置く
// 変換する関数は，実行中のプロセスの領域(UBASE・USIZEへ設定した領域)を対象とする(システムコールを処理する間も値が保たれるため)
#pragma once

static const unsigned int PROCESS_MEMORY_BASE = 0x8000;  // プロセス用の範囲の先頭のメモリの番地(カーネル用の範囲の直後．カーネルモードのCALL/RETはカーネル用の範囲にだけ戻り先を積むため，カーネルモードのスタックと重ならない)
static const unsigned int PROCESS_MEMORY_END = 0x20000;  // プロセス用の範囲の末尾の次のメモリの番地(メモリの容量)
static const unsigned int PROCESS_ARGS_AREA_SIZE = 256;  // 領域の末尾のうち，実行ファイルへ渡すコマンド名と引数を置くために取る大きさ
static const int PROCESS_MAX = 16;                       // プロセステーブルの要素数(同時にメモリに置けるプロセスの数．子を起動するたびにカーネルモードのスタックを約180バイト積むため，16段でもカーネル用の範囲に収まる数とした)
const int PROCESS_NONE = -1;                             // どのプロセスも指さないことを表す，プロセステーブルでの位置

// プロセスがカーネルへ入った時点のレジスタのうち，SPとPC以外に控えるレジスタの並び
// r0〜r15はレジスタ番地と同じ位置に，その後ろにRSI・RAXを置く(FLGはどの命令も書き換えず，UBASE・USIZEは領域から戻せるため控えない)
const int PROCESS_REGISTER_COUNT = 18;  // 控えるレジスタの数
const int PROCESS_REGISTER_RSI = 16;    // RSIの位置
const int PROCESS_REGISTER_RAX = 17;    // RAXの位置

// プロセスを加える関数の結果
const int PROCESS_CREATED = 0;     // 加えた
const int PROCESS_TABLE_FULL = 1;  // プロセステーブルに空いている要素が無い
const int PROCESS_NO_MEMORY = 2;   // 必要な大きさの領域が空きに収まらない

// プロセステーブルの要素．1つのプロセスを表す
// 再開するための値は，プロセスがシステムコールの命令かタイマー割り込みでカーネルモードへ入るたびに控える．プロセスを起動するとき，子が終わって親へ戻るとき，割り込みで止めたプロセスへ戻るときに，ここから戻す
// (子の終了を待つ親や，割り込みで止めたプロセスを，CPUのレジスタとグローバル変数が別のプロセスの値に変わった後も再開できるようにするため)
struct Process {
    int used;                                        // 要素を使っているか(1: 使っている / 0: 空いている)
    int parent;                                      // 親(このプロセスを起動し，終了を待つプロセス)のプロセステーブルでの位置．シェルが起動したプロセスは，どのプロセスも指さない位置
    unsigned int base;                               // 領域の先頭のメモリの番地
    unsigned int size;                               // 領域の大きさ(8の倍数)
    unsigned int sp;                                 // 再開するための値: カーネルへ入った時点のSP(領域の中の番地)
    unsigned int pc;                                 // 再開するための値: 再開する命令のPC
    unsigned int registers[PROCESS_REGISTER_COUNT];  // 再開するための値: カーネルへ入った時点のr0〜r15・RSI・RAX
    unsigned int kernel_sp;                          // 再開するための値: このプロセスが終わったときに戻るカーネルモードのSP
};

// プロセステーブル(親をプロセステーブルでの位置で指すため，各要素は動かさない)
struct Process process_table[PROCESS_MAX];
int process_current = PROCESS_NONE;  // 実行中のプロセスのプロセステーブルでの位置(シェルが動いている間は，どのプロセスも指さない位置)

// 先頭のメモリの番地baseから大きさsizeの候補の範囲に，領域を割り振れるかを返す(baseはプロセス用の範囲の中にあること)
// 戻り値: 1(割り振れる) / 0(割り振れない)
static int process_fits(unsigned int base, unsigned int size) {
    // 候補の範囲が，プロセス用の範囲の末尾を超えれば収まらない(baseはプロセス用の範囲の中にあるため，残りの大きさと比べれば桁あふれしない)
    if (PROCESS_MEMORY_END - base < size) {
        return 0;
    }

    // 使っている要素の領域と重なるかを順に調べる
    for (int i = 0; i < PROCESS_MAX; i++) {
        // 重なれば，その範囲には割り振れない
        if (
            // 要素を使っている
            process_table[i].used
            // かつ，候補の範囲の先頭が領域の末尾より前にある
            && base < process_table[i].base + process_table[i].size
            // かつ，領域の先頭が候補の範囲の末尾より前にある
            && process_table[i].base < base + size) {
            return 0;
        }
    }

    return 1;
}

// 大きさsizeの領域を割り振る位置を空きから選び，その先頭のメモリの番地を返す．空きに収まらなければ0を返す(0はプロセス用の範囲の外のため，選んだ番地と区別できる)
static unsigned int process_find_free(unsigned int size) {
    unsigned int found = 0;  // 見つかった位置のうち番地の最も小さい先頭(見つかっていなければ0)
    unsigned int end;        // 調べている領域の直後のメモリの番地

    // プロセス用の範囲の先頭に収まれば，そこが番地の最も小さい位置になる
    if (process_fits(PROCESS_MEMORY_BASE, size)) {
        return PROCESS_MEMORY_BASE;
    }

    // 使っている要素の領域の直後を順に調べ，収まる位置のうち番地の最も小さいものを残す
    // (プロセス用の範囲の先頭に収まらなければ，番地の最も小さい位置はいずれかの領域の直後になるため，それらだけを調べる)
    for (int i = 0; i < PROCESS_MAX; i++) {
        // 空いている要素は領域を持たないため調べない
        if (!process_table[i].used) {
            continue;
        }

        // 領域の直後の番地を求める
        end = process_table[i].base + process_table[i].size;

        // 見つかった位置より番地が小さく，収まれば残す
        if (
            // まだ見つかっていないか，見つかった位置より番地が小さい
            (found == 0 || end < found)
            // かつ，その位置に収まる
            && process_fits(end, size)) {
            found = end;
        }
    }

    return found;
}

// 実行ファイルのプロセスをプロセステーブルに加え，領域を割り振る(実行中のプロセスがあれば，そのプロセスを親とする)
// code_size・reserve_size・stack_size: 実行ファイルのヘッダに書かれた，命令列・命令列の直後に確保する範囲・スタックの量のバイト数(以下，3つの大きさ)
// process: 加えたプロセスのプロセステーブルでの位置の書き込み先
// 戻り値: PROCESS_CREATED / PROCESS_TABLE_FULL / PROCESS_NO_MEMORY(3つの大きさがプロセス用の範囲全体にも収まらない場合を含む)
int process_create(unsigned int code_size, unsigned int reserve_size, unsigned int stack_size, int *process) {
    unsigned int rest = PROCESS_MEMORY_END - PROCESS_MEMORY_BASE - PROCESS_ARGS_AREA_SIZE;  // 3つの大きさを収められる残りの大きさ(初めは，プロセス用の範囲全体から引数の置き場を除いた大きさ)
    unsigned int size;                                                                      // 割り振る領域の大きさ
    unsigned int base;                                                                      // 割り振る領域の先頭のメモリの番地
    int index = PROCESS_NONE;                                                               // 加える要素のプロセステーブルでの位置

    // 空いている要素を探し，無ければ加えられない
    for (int i = 0; i < PROCESS_MAX; i++) {
        if (!process_table[i].used) {
            index = i;
            break;
        }
    }

    if (index == PROCESS_NONE) {
        return PROCESS_TABLE_FULL;
    }

    // 3つの大きさがプロセス用の範囲全体に収まるかを，残りの大きさから順に引いて確かめる
    // (大きさはヘッダからファイルの値をそのまま受け取るため，そのまま足すと桁あふれして収まると誤る)
    if (code_size > rest) {
        return PROCESS_NO_MEMORY;
    }
    rest -= code_size;
    if (reserve_size > rest) {
        return PROCESS_NO_MEMORY;
    }
    rest -= reserve_size;
    if (stack_size > rest) {
        return PROCESS_NO_MEMORY;
    }

    // 領域の大きさを，3つの大きさの合計を8の倍数へ切り上げ(USIZEは8の倍数しか持てないため)，引数の置き場を足したものにする
    // (合計は，プロセス用の範囲全体から引数の置き場を除いた8の倍数の大きさ以下のため，切り上げてもプロセス用の範囲を超えない)
    size = ((code_size + reserve_size + stack_size + 7) & ~7) + PROCESS_ARGS_AREA_SIZE;

    // 空きから領域を割り振る位置を選び，無ければ加えられない
    base = process_find_free(size);
    if (base == 0) {
        return PROCESS_NO_MEMORY;
    }

    // 空いている要素に，実行中のプロセスを親として領域を記録する
    process_table[index].used = 1;
    process_table[index].parent = process_current;
    process_table[index].base = base;
    process_table[index].size = size;
    // 実行ファイルを先頭の命令から，レジスタをすべて0にして始めるための値を書く
    // (SPとカーネルモードのSPはここでは0とし，実行ファイルへ入るときに決めた値を，最初にカーネルモードへ入ったときに控える)
    process_table[index].sp = 0;
    process_table[index].pc = 0;
    for (int i = 0; i < PROCESS_REGISTER_COUNT; i++) {
        process_table[index].registers[i] = 0;
    }
    process_table[index].kernel_sp = 0;
    *process = index;
    return PROCESS_CREATED;
}

// プロセステーブルでの位置processのプロセスを，プロセステーブルから外す
void process_destroy(int process) {
    // 要素を空ける(領域はどの要素からも指されなくなるため，空きに戻る)
    process_table[process].used = 0;
}

// 実行中のプロセスの領域の中の番地addrを，メモリの番地を指すポインタへ変換する．addrからsizeバイトの範囲が領域に収まらなければnullptrを返す
// (実行ファイルから受け取った番地を，読み書きする前に確かめて変換するために使う．領域の外をカーネルモードで読み書きすると，OSのデータを壊すか，CPUが停止するため)
char *process_buffer(unsigned int addr, int size) {
    // 範囲が領域に収まらなければ，nullptrを返す
    if (
        // 先頭が領域の外にある(実行ファイルがintで渡した負の番地とnullptrも，符号なしの値として領域の大きさを超えるため，ここに当たる)
        addr >= USIZE
        // または，大きさが負である
        || size < 0
        // または，末尾が領域の外にある(先頭が領域の中にあることを確かめた後に，残りの大きさと比べるため桁あふれしない)
        || (unsigned int)size > USIZE - addr) {
        return nullptr;
    }

    return (char *)(UBASE + addr);
}

// 実行中のプロセスの領域の中の番地addrを，メモリの番地を指すポインタへ変換する．addrから始まる文字列が，ヌル終端まで領域に収まらなければnullptrを返す
char *process_string(unsigned int addr) {
    char *text = process_buffer(addr, 1);  // 文字列の先頭

    // 先頭が領域の外にあれば，nullptrを返す
    if (text == nullptr) {
        return nullptr;
    }

    // 先頭から領域の末尾までにヌル終端があるかを調べる
    for (unsigned int i = 0; i < USIZE - addr; i++) {
        // ヌル終端があれば，文字列全体が領域に収まる
        if (text[i] == '\0') {
            return text;
        }
    }

    return nullptr;
}
