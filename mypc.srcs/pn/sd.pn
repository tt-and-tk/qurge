// SDカードのドライバ．Arduino互換ヘッダのSPIピン(AR_SPI)をソフトウェアで駆動してカードを初期化し，ブロックを読み書きする
#pragma once

const int SD_BLOCK_SIZE = 512;  // 1ブロックのバイト数(扱うSDHC/SDXCカードはこの長さに固定されている)

// SS(チップセレクト)の出力レベル(0:カードを選択中，1:非選択)
// AR_SPIへの書き込みは常に全ビットを同時に置き換えるため，SSだけを別に保ち回す
int spi_ss = 1;  // 初期値はハードウェアのリセット値(非選択)と揃える

int sd_ready = 0;  // カードの初期化が完了しているか(0:未完了，1:完了)

// 0〜15の値を16進数1桁の文字へ変換する
char hex(int value) {
    // 0〜9は数字，10〜15は英小文字のa〜fで表す
    if (value < 10) {
        return '0' + value;
    }
    return 'a' + value - 10;
}

// valueを"0x??"の形式で出力する(改行は付けない)
void print_hex(char value) {
    char hex_buf[5];  // 出力用の一時バッファ
    // "0x"に続けて上位・下位の4ビットを1桁ずつ並べ，終端して出力する
    hex_buf[0] = '0';
    hex_buf[1] = 'x';
    hex_buf[2] = hex((value >> 4) & 0x0f);  // 上位4ビット
    hex_buf[3] = hex(value & 0x0f);         // 下位4ビット
    hex_buf[4] = '\0';
    print(hex_buf);
}

// 初期化に失敗した段階の行の末尾へ，判定に使った応答値を" (0x??)"の形で添えて改行する
void print_response(char value) {
    // 応答値を括弧で囲んで出力し，行を終える
    print(" (");
    print_hex(value);
    print(")\n");
}

// SPIモード0のビットバンギングで1バイトを送信し，同時に受信した1バイトを返す
// SPIは全二重で送信と受信が常に対になるため，受信だけしたい場合は0xffを渡すこと
unsigned char spi_transfer(char data) {
    // AR_SPIのビット割り当て(bit3:MISO(入力) / bit2:SCK / bit1:MOSI / bit0:SS(アクティブLow))

    unsigned char received = 0;  // MISOから上位ビット順に組み立てる受信バイト
    int level;                   // SSとMOSIを反映したAR_SPIへの書き込み値(SCKはLow)

    for (int i = 7; i >= 0; i--) {
        // SPI上の送信順は上位ビットからのため，iビット目を取り出してMOSI(bit1)へ置く
        level = spi_ss | (((data >> i) & 1) << 1);
        // SCKをLowに保ったままMOSIを確定させる．カードはこの立ち下がりでMISOへ次のビットを載せる
        AR_SPI = level;
        // SCK(bit2)をHighへ上げる．カードはこの立ち上がりでMOSIを取り込む
        AR_SPI = level | 4;
        // MISO(bit3)を読み，受信バイトの下位へ積む
        // AR_SPIのMISOは同期化を挟むためピンより3サイクル遅れるが，値を載せた立ち下がりから
        // ここまでに複数の命令を挟んでおり，読む時点では確定した値が現れている
        received = (received << 1) | ((AR_SPI >> 3) & 1);
    }
    // 8ビット送り終えたらSCKをLowへ戻し，MOSIはアイドルのHighにして次の転送に備える
    AR_SPI = spi_ss | 2;
    return received;
}

// SDカードへコマンドを送り，R1応答を返す(応答が得られなければ0xffを返す)
int sd_command(int cmd_index, int arg, int crc) {
    int response;  // カードから受け取った1バイト

    // 直前の処理でカードがビジーならば抜けさせるためのクロックを8回与える
    spi_transfer(0xff);
    // コマンドフレームは6バイト固定で，先頭バイトの上位2ビット'01'がホストからの送信を表す
    spi_transfer(0x40 | cmd_index);
    // 引数32ビットを上位バイトから順に送る(下位8ビット以外は引数の型が切り捨てる)
    spi_transfer(arg >> 24);
    spi_transfer(arg >> 16);
    spi_transfer(arg >> 8);
    spi_transfer(arg);
    // SPIモードではCRCは基本的に無視されるが，CMD0とCMD8だけは正しい値が必須のため呼び出し元から受け取る
    spi_transfer(crc);

    // 応答が返るまでの間はMISOがHigh(0xff)のままなので，最上位ビットが0のバイトが応答の先頭になる
    // 規格上の待ち時間(NCR)は最大8バイトのため，余裕を見て16回まで読む
    for (int i = 0; i < 16; i++) {
        response = spi_transfer(0xff);
        if ((response & 0x80) == 0) {
            return response;
        }
    }
    return 0xff;
}

// カードを非選択へ戻して解放する
// カードの内部状態機械はSCKでしか進まないため，SSを戻した後に8クロック与えて後始末を完了させる
void sd_release(void) {
    spi_ss = 1;
    spi_transfer(0xff);
}

// 初期化のコマンド列を順に実行する
// どこで失敗したのかが分かるよう，段階ごとに結果が決まった時点で成功([ OK ])か失敗([FAIL])の行を出力する．失敗した段階の行には理由と応答値を添え，以降の段階は実行しない
// 呼び出す前にspi_ssを0にしてカードを選択しておくこと
// 戻り値: 1(初期化完了) / 0(失敗)
int sd_init_commands(void) {
    // カードが返す応答の形式
    // R1: どのコマンドにも共通する1バイトのステータス(bit0:in idle state / bit2:illegal command / bit7:常に0)
    // R3: CMD58だけが返す形式で，R1に4バイトのOCRが続く
    // R7: CMD8だけが返す形式で，R1に4バイトが続く

    int response;  // 各コマンドのR1応答
    int received;  // R1の後に届く4バイト(R1自体は含まない)を1バイトずつ受け取る変数
    int echoed;    // R7の末尾2バイト(受理された電圧範囲とチェックパターン)
    int ocr_high;  // R3のOCRの最上位バイト(CCSビットを含む)
    int ready;     // ACMD41が完了を返したか(0:未完了，1:完了)

    // CMD0(GO_IDLE_STATE): ソフトリセット．アイドル状態へ入ればin idle stateのみが立った0x01が返る
    response = sd_command(0, 0x00000000, 0x95);
    // 無応答(0xff)はカードが差さっていない場合に起きるため，他の応答と分けて伝える
    if (response == 0xff) {
        print("[FAIL] SD card: reset (CMD0): no response");
        print_response(response);
        return 0;
    }
    if (response != 0x01) {
        print("[FAIL] SD card: reset (CMD0): unexpected response");
        print_response(response);
        return 0;
    }
    print("[ OK ] SD card: reset (CMD0)\n");

    // CMD8(SEND_IF_COND): 2.7〜3.6Vで動かせるかの問い合わせ．引数下位の0xaaはエコーバックされるチェックパターン
    response = sd_command(8, 0x000001aa, 0x87);
    // 無応答を表す0xffはillegal commandビットも含むため，v1カードの判定より先に切り分ける
    if (response == 0xff) {
        print("[FAIL] SD card: voltage check (CMD8): no response");
        print_response(response);
        return 0;
    }
    // CMD8はSD規格v2で追加されたため，v1カードはillegal command(bit2)を立てて拒否する
    // v1カードはすべてバイト単位の番地を使うSDSCであり扱わないため，R1しか返らない拒否応答の後は続く4バイトを読まずここで止める
    if ((response & 0x04) != 0) {
        print("[FAIL] SD card: voltage check (CMD8): SD v1, unsupported");
        print_response(response);
        return 0;
    }
    // v2カードはR1にエラービットが立っていてもR7で応答する
    // R1の後に届く4バイトのうち，末尾2バイトが受理された電圧範囲と送ったチェックパターンのエコーバックになる
    // 失敗した場合も4バイト読み切らないと以降の転送がずれるため，読み出しは先に済ませる
    echoed = 0;
    for (int i = 0; i < 4; i++) {
        received = spi_transfer(0xff);
        echoed = ((echoed << 8) | received) & 0xffff;  // 末尾2バイトだけを残す
    }
    if (response != 0x01) {
        print("[FAIL] SD card: voltage check (CMD8): failed");
        print_response(response);
        return 0;
    }
    // CMD8の引数0x000001aaの下位2バイト(0x01=2.7〜3.6V，0xaa=チェックパターン)がそのまま戻らなければ，配線か電圧に問題がある
    // 判定に使ったのはR1ではなく戻ってきた2バイトのため，その2バイトを並べて添える
    if (echoed != 0x01aa) {
        print("[FAIL] SD card: voltage check (CMD8): check pattern mismatch (");
        print_hex(echoed >> 8);
        print(" ");
        print_hex(echoed);
        print(")\n");
        return 0;
    }
    print("[ OK ] SD card: voltage check (CMD8)\n");

    // ACMD41(SD_SEND_OP_COND): 初期化の開始指示．内部初期化中は0x01を返し続け，完了すると0x00になる
    // 完了まで最大1秒かかることが規格上許容されているため，それを上回るだけの回数を見る
    ready = 0;
    for (int i = 0; i < 50000 && ready == 0; i++) {
        // ACMDはCMDとは別の命令セットで，CMD55の直後の1コマンドだけがそちらとして解釈される
        response = sd_command(55, 0x00000000, 0x65);
        // CMD55が通っていないと続くコマンドは通常のCMD41として解釈されるため，前提が崩れたまま繰り返さず止める
        // カードはACMD41が完了するまでアイドル状態にあるため，in idle state(bit0)以外が立っていれば失敗とみなす
        if ((response & 0xfe) != 0) {
            print("[FAIL] SD card: initialize (ACMD41): CMD55 rejected");
            print_response(response);
            return 0;
        }
        // 引数のbit30(HCS)で大容量カード(SDHC/SDXC)を扱えるホストであることを申告する
        response = sd_command(41, 0x40000000, 0x77);
        // in idle state(bit0)以外が立っていればエラー応答か無応答であり，繰り返しても完了しないため止める
        if ((response & 0xfe) != 0) {
            print("[FAIL] SD card: initialize (ACMD41): failed");
            print_response(response);
            return 0;
        }
        if (response == 0x00) {
            ready = 1;
        }
    }
    if (ready == 0) {
        // 上限まで繰り返しても完了しなかった(添えるのは最後に返った応答)
        print("[FAIL] SD card: initialize (ACMD41): not ready");
        print_response(response);
        return 0;
    }
    print("[ OK ] SD card: initialize (ACMD41)\n");

    // CMD58(READ_OCR): ブロック単位の番地を使うカード(SDHC/SDXC)かを表すCCSビットを読む
    // 応答はR3(R1に4バイトのOCRが続く)で，CCSはOCRの最上位バイトのbit6にある
    response = sd_command(58, 0x00000000, 0x01);
    // 失敗した場合も4バイト読み切らないと以降の転送がずれるため，読み出しは先に済ませる
    // OCRのbit31(power up status)は確認しない．ACMD41が完了を返した後であり，必ず立っているため
    ocr_high = 0;
    for (int i = 0; i < 4; i++) {
        received = spi_transfer(0xff);
        if (i == 0) {
            ocr_high = received;
        }
    }
    if (response != 0x00) {
        print("[FAIL] SD card: card type (CMD58): failed");
        print_response(response);
        return 0;
    }
    // CCSが0のカードはバイト単位の番地を使うSDSCであり，ブロック番号をそのまま番地として渡すと誤った位置を読み書きするため扱わない
    // 判定に使ったのはR1ではなくOCRの最上位バイトのため，そちらを添える
    if (((ocr_high >> 6) & 1) == 0) {
        print("[FAIL] SD card: card type (CMD58): SDSC, unsupported");
        print_response(ocr_high);
        return 0;
    }
    print("[ OK ] SD card: card type SDHC/SDXC (CMD58)\n");
    return 1;
}

// SDカードをSPIモードへ入れ，ブロックを読み書きできる状態まで初期化する
// ブロック単位の番地を使うカードであることの確認までを含むため，完了後はブロックの読み書きをそのまま行える
// 初期化の各段階の成否を1行ずつ出力する(起動時のハードウェアの初期化として，経過を利用者に見せるため)
// 戻り値: 1(初期化完了) / 0(失敗)
int sd_init(void) {
    int ready;  // 初期化コマンド列の結果

    // カードは自前の発振器を持たずSCKで内部回路を動かすため，電源投入後に74クロック以上を与える必要がある(ここでは80クロック)
    // SSをHighのまま送ることで，カードはこれをコマンドと解釈せず単なるクロック供給として受け取る
    spi_ss = 1;
    for (int i = 0; i < 10; i++) {
        spi_transfer(0xff);
    }

    // カードを選択してから初期化のコマンド列を発行する
    // カードはCMD0を受け取った瞬間のSSでモードを決めるため，ここで選択しておくことがSPIモードへの切り替えになる
    spi_ss = 0;
    ready = sd_init_commands();

    // 途中で失敗してもカードがMISOを掴んだままにならないよう，成否によらずここで解放する
    sd_release();
    sd_ready = ready;
    return ready;
}

// 1ブロックを読み出し，bufの先頭からSD_BLOCK_SIZEバイトへ格納する
// 失敗しても表示は行わない(他の出力の途中でも呼ばれるため，失敗の伝え方は呼び出し元が決める)
// 戻り値: 1(読み出し成功) / 0(失敗．bufの内容は保証されない)
int sd_read_block(unsigned int block, unsigned char *buf) {
    int response;   // CMD17のR1応答
    int token;      // カードから最後に受け取ったバイト(待ちの上限に達したときはMISOのアイドル値0xffになる)

    // ブロック単位の番地を使うカードだと確認できていないと誤った位置を読むため，初期化が完了していなければ読まない
    if (sd_ready == 0) {
        return 0;
    }

    // カードを選択して読み出しを要求する
    spi_ss = 0;
    // CMD17(READ_SINGLE_BLOCK): 1ブロックの読み出し要求．番地はブロック番号そのもので，CRCは無視されるためエンドビットのみを立てた値を渡す
    response = sd_command(17, block, 0x01);
    // 要求が受理されなければ，カードを解放して失敗とする
    if (response != 0x00) {
        sd_release();
        return 0;
    }

    // データが揃うまでMISOはHigh(0xff)のままで，先頭に0xfeのデータ開始トークンが現れる
    // 規格上の読み出し時間の上限(100ms)を上回るだけの回数を見る(1バイトの転送に最低でも数百サイクルかかる)
    for (int i = 0; i < 200000; i++) {
        token = spi_transfer(0xff);
        if (token != 0xff) {
            break;
        }
    }
    // 0xff以外で0xfeでないものはエラートークンであり，待っても0xfeへは変わらない
    if (token != 0xfe) {
        sd_release();
        return 0;
    }

    // データ開始トークンに続く1ブロック分を受け取る
    for (int i = 0; i < SD_BLOCK_SIZE; i++) {
        buf[i] = spi_transfer(0xff);
    }
    // データの後にCRCが2バイト続く．SPIモードでは検査されないため読み捨てる
    spi_transfer(0xff);
    spi_transfer(0xff);
    // 読み出しを終えたカードを解放する
    sd_release();
    return 1;
}

// bufの先頭からSD_BLOCK_SIZEバイトを，1ブロックへ書き込む
// 失敗しても表示は行わない(他の出力の途中でも呼ばれるため，失敗の伝え方は呼び出し元が決める)
// 戻り値: 1(書き込み成功) / 0(失敗．ブロックの内容は保証されない)
int sd_write_block(unsigned int block, unsigned char *buf) {
    int response;  // CMD24のR1応答と，書き込んだデータへの応答

    // ブロック単位の番地を使うカードだと確認できていないと誤った位置へ書くため，初期化が完了していなければ書かない
    if (sd_ready == 0) {
        return 0;
    }

    // カードを選択して書き込みを要求する
    spi_ss = 0;
    // CMD24(WRITE_BLOCK): 1ブロックの書き込み要求．番地はブロック番号そのもので，CRCは無視されるためエンドビットのみを立てた値を渡す
    response = sd_command(24, block, 0x01);
    // 要求が受理されなければ，カードを解放して失敗とする
    if (response != 0x00) {
        sd_release();
        return 0;
    }

    // 応答とデータ開始トークンの間には1バイト以上の間隔が必要なため，ダミーを1バイト挟む
    spi_transfer(0xff);
    // データ開始トークン(0xfe)に続けて1ブロック分を送る
    spi_transfer(0xfe);
    for (int i = 0; i < SD_BLOCK_SIZE; i++) {
        spi_transfer(buf[i]);
    }
    // データの後にCRCを2バイト送る．SPIモードでは検査されないためダミーでよい
    spi_transfer(0xff);
    spi_transfer(0xff);

    // カードはデータを受け取ると，下位5ビットで受理(0x05)・CRCエラー・書き込みエラーを表す応答を返す
    // 応答はMISOのアイドル値(0xff)と違ってbit4が0になるため，それが現れるまで読む(規格上は直後に返るが，余裕を見て16回まで読む)
    response = 0xff;
    for (int i = 0; i < 16 && (response & 0x10) != 0; i++) {
        response = spi_transfer(0xff);
    }
    if ((response & 0x1f) != 0x05) {
        sd_release();
        return 0;
    }

    // カードは受理したデータを書き終えるまでMISOをLowに保ち(ビジー)，書き終えるとアイドル値(0xff)へ戻す
    // 規格上の書き込み時間の上限(SDXCで500ms)を上回るだけの回数を見る(読み出しの待ちの回数が100msを上回る値であり，その5倍)
    for (int i = 0; i < 1000000; i++) {
        if (spi_transfer(0xff) == 0xff) {
            sd_release();
            return 1;
        }
    }
    // 上限まで待っても書き終わらなければ失敗とする
    sd_release();
    return 0;
}
