// 実行ファイルに割り振る領域の位置・大きさと，OSが領域の中の番地を読み書きするための関数
// 実行ファイルは，領域の先頭を0とするバイト単位の番地(以下，領域の中の番地)でユーザーモードとして動く
// 領域の中の番地は，命令の取り出しとメモリの読み書きのたびにCPUがメモリの番地へ変換する．カーネルモードで動くOSは変換されないため，ここの関数で変換する
#pragma once

const int EXEC_REGION_BASE = 0x8000;         // 領域の先頭のメモリの番地(メモリの後半の先頭)
const int EXEC_REGION_SIZE = 0x8000;         // 領域の大きさ(メモリの後半全体)
static const int EXEC_ARGS_AREA_SIZE = 256;  // 領域の末尾のうち，実行ファイルへ渡すコマンド名と引数を置くために取る大きさ
const int EXEC_CODE_SIZE = EXEC_REGION_SIZE - EXEC_ARGS_AREA_SIZE;  // 読み込める実行ファイルの大きさの上限(領域のうち，末尾のコマンド名と引数の置き場より手前)

// 領域の中の番地addrからsizeバイトの範囲が領域に収まれば，その先頭に対応するメモリの番地を指すポインタを返す．収まらなければnullptrを返す
// (実行ファイルから受け取った番地を，読み書きする前に確かめるために使う．領域の外をカーネルモードで読み書きすると，OSのデータを壊すか，CPUが停止するため)
// 実行ファイルがintで渡した負の番地とnullptrは，符号なしの値として領域の大きさを超えるため，領域の外として扱われる
char *exec_region_buffer(unsigned int addr, int size) {
    // 範囲が領域に収まらなければ，nullptrを返す
    if (
        // 先頭が領域の外にある
        addr >= EXEC_REGION_SIZE
        // または，大きさが負である
        || size < 0
        // または，末尾が領域の外にある(先頭が領域の中にあることを確かめた後に，残りの大きさと比べるため桁あふれしない)
        || (unsigned int)size > EXEC_REGION_SIZE - addr) {
        return nullptr;
    }
    return (char *)(EXEC_REGION_BASE + addr);
}

// 領域の中の番地addrから始まるヌル終端の文字列が，ヌル終端まで領域に収まれば，その先頭に対応するメモリの番地を指すポインタを返す．
// 収まらなければnullptrを返す
char *exec_region_string(unsigned int addr) {
    char *text = exec_region_buffer(addr, 1);  // 文字列の先頭

    // 先頭が領域の外にあれば，nullptrを返す
    if (text == nullptr) {
        return nullptr;
    }
    // 先頭から領域の末尾までにヌル終端があるかを調べる
    for (int i = 0; i < EXEC_REGION_SIZE - addr; i++) {
        // ヌル終端があれば，文字列全体が領域に収まる
        if (text[i] == '\0') {
            return text;
        }
    }
    return nullptr;
}
