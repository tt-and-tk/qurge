// USBのシリアル通信(UART)でバイトを送受信する関数群．画面への出力は行わない(結果の伝え方は呼び出し元が決める)
//
// PYNQ-Z2の電源用のUSBは，PS(ARM側)のUART0にだけつながっている．QurgeのCPUは，ハードウェア変数UARTのレジスタを通して，PSのUART0を使う回路(以下，橋渡し回路)を操作する
// 橋渡し回路は，送信するデータをためる送信バッファと，受信したバイトをためる受信バッファを持つ．どちらも2KBで，送受信そのものは橋渡し回路が行う
// UARTのレジスタは，書き込む値と読み出す値でビットの意味が異なる
// - 書き込む値: 0〜7ビット目が送信するデータ，8ビット目が送信の指示(立てると，送信するデータを送信バッファへ入れる)，9ビット目が読み終えた通知(立てると，受信バッファの先頭のバイトを読み終えたことを伝え，そのバイトを取り除かせる)
// - 読み出す値: 16〜23ビット目が受信バッファの先頭のバイト，24ビット目が受信したバイトがあるか，25ビット目が送信バッファに空きがあるか
//   24・25ビット目は，指示や通知を書き込んでから反映が済むまでの数サイクルは0を，その後は反映した後の状態を読む．このため，1を読めば指示や通知を反映した後の状態である
#pragma once

// UARTのレジスタへ書き込む指示
const unsigned int UART_TX_REQUEST = 0x100;  // 送信の指示
const unsigned int UART_RX_POP = 0x200;      // 読み終えた通知

// UARTのレジスタから読み出す状態
const int UART_RX_HEAD_SHIFT = 16;                 // 受信バッファの先頭のバイトの位置
const unsigned int UART_RX_NOT_EMPTY = 0x1000000;  // 受信したバイトがあるか
const unsigned int UART_TX_NOT_FULL = 0x2000000;   // 送信バッファに空きがあるか

// 送信バッファの空きを待つ空ループの反復回数の上限
// タイマーが無いため，空ループ1反復の命令数から最短の時間を見積もる．1反復はコンパイル結果で4命令以上であり，QurgeのCPUは1サイクル(100MHzで10ns)に多くとも2命令しか実行しないため，20ns以上かかる
// 橋渡し回路が動いていれば，空きは1バイトを送る時間(115200bpsで約87us)ごとにできるため，その10倍ほどの1ms以上待つ回数とする
const int UART_SEND_WAIT_LOOPS = 50000;

// 送信が止まっているか(0:止まっていない，1:止まっている)
// 送信バッファに空きができるのを上限の回数まで待っても，空きができなかったときに，送信が止まっているとみなして1にする．空きができたときに0に戻す
int uart_stalled = 0;

// 1バイトを送信バッファへ入れる．空きが無いときは，送信が止まっているか(止まっているとみなす条件は，送信が止まっているかを表す変数の説明を参照)で次のように扱う
// - 止まっていない: 上限の回数まで空くのを待ち，空かなければ捨てて，送信が止まっているとみなす
// - 止まっている: すぐに捨てる(橋渡し回路が止まっている場合でも，出力のたびに長く待たず，telnetで接続した端末などほかの処理を進められるようにするため)
void uart_send(char c) {
    // 空きがあるかを確かめる．送信が止まっていなければ上限の回数を限度に繰り返し，止まっていれば1回だけ確かめる
    for (int i = 0; i < UART_SEND_WAIT_LOOPS; i++) {
        // 空きがあれば，送信するデータを送信バッファへ入れる
        if ((UART & UART_TX_NOT_FULL) != 0) {
            // 送信の指示のビットと，UARTで送信するデータ(1バイト)を合わせて書き込む
            UART = UART_TX_REQUEST | (c & 0xff);
            // 空きができたため，送信が止まっていない状態に戻す
            uart_stalled = 0;
            return;
        }
        // 送信が止まっていれば，待たずに捨てる
        if (uart_stalled) {
            return;
        }
    }
    // 上限の回数まで待っても空かなかったため，送信が止まっているとみなし，捨てる
    uart_stalled = 1;
}

// 受信バッファの先頭のバイトを，届くのを待たずに取り出す
// 戻り値: 取り出したバイトの値(0〜255) / -1(受信したバイトが無い)
int uart_receive(void) {
    unsigned int status = UART;  // UARTのレジスタから読み出した状態

    // 受信したバイトが無ければ，取り出さない
    if ((status & UART_RX_NOT_EMPTY) == 0) {
        return -1;
    }
    // 取り出しを指示して，先頭のバイトを受信バッファから取り除く
    UART = UART_RX_POP;
    // 読み出した状態から先頭のバイトを返す
    return (status >> UART_RX_HEAD_SHIFT) & 0xff;
}
