// 自作OS Qosmosの本体(ROMに書き込むプログラムの入口)．起動時にハードウェアを初期化してOS名を表示した後，シェルとして動く
// シェルは標準入力から1行受け取り，先頭のトークンをコマンド名として解析し，対応する処理を呼び出す
#include "args.pn"
#include "sd.pn"
#include "fat.pn"

const int INPUT_SIZE = 64;          // 1行分の入力バッファの要素数(引数を取り出す配列も同じ幅で確保し，打ち切りを起こさない)
const int ERROR_MESSAGE_SIZE = 32;  // エラーメッセージを出力する一時バッファの要素数
const int CODE_ADDRESS = 0x8000;    // コード領域の先頭番地(実行ファイルの読み込み先)
const int CODE_SIZE = 0x8000;       // コード領域のバイト数(読み込める実行ファイルの大きさの上限)
const int CODE_PC = 0x4000;         // コード領域の先頭の命令を指すPC(実行ファイルの入口)
const int INSTRUCTION_SIZE = 8;     // 1命令のバイト数(実行ファイルの大きさはこの倍数になる)

char input[INPUT_SIZE];  // 1行分の入力バッファ
char cmd[INPUT_SIZE];    // 入力の先頭トークン(コマンド名)

// エラーメッセージの前置き"<コマンド名>: "を出力する(どのコマンドが出したエラーかが分かるようにするため)
void print_error_head(void) {
    // 実行中のコマンド名に区切りを続けて出力する
    print(cmd);
    print(": ");
}

// エラーを"<コマンド名>: <msg>"の形式で出力する(msgは末尾の改行まで含めて渡す)
void print_error(char *msg) {
    char msg_buf[ERROR_MESSAGE_SIZE];  // 出力用の一時バッファ(printは配列変数のみ受け付けるため)
    int i = 0;                         // msgから写した文字数
    // msgをヌル終端かバッファ幅の手前まで一時バッファへ写し，終端する
    while (msg[i] != '\0' && i < ERROR_MESSAGE_SIZE - 1) {
        msg_buf[i] = msg[i];
        i = i + 1;
    }
    msg_buf[i] = '\0';
    // 前置きに続けてメッセージを出力する
    print_error_head();
    print(msg_buf);
}

// FAT32の各関数が返した失敗を，実行中のコマンドのエラーとして出力する
void print_fat_error(int status) {
    // 前置きに続けて，失敗の理由のメッセージを出力する
    print_error_head();
    fat_print_error(status);
}

// ちょうど1つの引数を取るコマンドで，posより後ろの引数をargへ取り出す(argはINPUT_SIZE要素で確保すること)
// 引数が無いか余分な引数があればエラーを出力して0を返し，取り出せれば1を返す
// 入力行の解析を担うargs.pnに置かないのは，シェルの入力行inputとコマンド名を前置するエラー表示を使うため(args.pnはシェルに依存しない)
int extract_only_arg(int pos, char *arg) {
    // 直後の引数を取り出す
    pos = extract_arg(input, pos, arg, INPUT_SIZE);
    // 引数が指定されていなければ何もしない
    if (arg[0] == '\0') {
        print_error("missing argument\n");
        return 0;
    }
    // 引数の後に余分な引数があれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return 0;
    }
    return 1;
}

// echoコマンド: コマンド名以降の引数部分をそのまま出力する
void handle_echo(int pos) {
    char args[INPUT_SIZE];  // コマンド名を除いた引数部分
    // コマンド名より後ろを丸ごと取り出し，改行を付けて出力する
    extract_text_arg(input, pos, args, INPUT_SIZE);
    print(args);
    print("\n");
}

// ディレクトリの走査で，エントリの名前を1行出力する(ディレクトリは末尾に'/'を付けて区別する)
// fat_walkへ渡す関数は走査を打ち切るかどうかを戻り値で伝える決まりのため，常に続ける場合もvoidにはしない
int print_entry(struct FatEntry *entry) {
    char text[FAT_NAME_TEXT_SIZE];  // 表示用の名前
    // エントリの名前を"NAME.EXT"形式に整えて出力する
    fat_format_name(entry, text);
    print(text);
    // ディレクトリであれば，ファイルと見分けられるよう末尾に'/'を付ける
    if ((entry->attr & ATTR_DIRECTORY) != 0) {
        print("/");
    }
    // 1エントリを1行とする
    print("\n");
    // 全エントリを出力するため，走査は打ち切らない
    return 0;
}

// lsコマンド: 現在のディレクトリにあるファイル・ディレクトリの名前を順に出力する
void handle_ls(int pos) {
    int status;  // 走査の結果

    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // 現在のディレクトリを走査して各エントリの名前を出力し，走査に失敗すればその理由を出力する
    status = fat_walk(print_entry);
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// catコマンド: 引数のファイル名に対応するファイルの内容を出力する
void handle_cat(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(読み出すファイル名)
    struct FatEntry entry;  // 見つかったファイルのエントリ
    struct FatFile file;    // 読み出し中のファイルの位置
    int length;             // 読み込んだセクタのうち内容にあたるバイト数
    int status;             // FAT32の各関数の結果
    int last = '\n';        // 最後に出力した文字(内容が改行で終わらなければ改行を補うため．空のファイルでは補わないよう改行から始める)

    // コマンド名(cat)の直後の引数をファイル名として取り出す．引数が無いか余分な引数があれば，取り出す処理がエラーを出力するため何もせず終える
    if (extract_only_arg(pos, name) == 0) {
        return;
    }

    // ファイル名から対象のエントリを探して開く
    status = fat_find(name, &entry);
    if (status == FAT_OK) {
        status = fat_open(&entry, &file);
    }
    if (status != FAT_OK) {
        print_fat_error(status);
        return;
    }

    // 1セクタずつ読み込んで出力する
    while (1) {
        // 次の1セクタを読み込む．全て読み終えていれば出力を終える
        status = fat_read(&file, &length);
        if (status == FAT_END) {
            break;
        }
        // 読み出しに失敗すれば，その理由を出力して終える
        if (status != FAT_OK) {
            // 途中まで出力した内容とエラーメッセージが同じ行に並ばないよう改行を挟む
            if (last != '\n') {
                print("\n");
            }
            print_fat_error(status);
            return;
        }
        // 末尾に改行を補うかどうか判断できるよう，内容の最後の文字を控える
        last = fat_sector[length - 1];
        // printはヌル終端か配列の終わりまでを出力するため，内容がセクタの途中で終わる場合だけ終端を置く
        if (length < SD_BLOCK_SIZE) {
            fat_sector[length] = '\0';
        }
        print(fat_sector);
    }
    // 内容が改行で終わっていなければ，次のプロンプトが同じ行に並ばないよう改行を補う
    if (last != '\n') {
        print("\n");
    }
}

// touchコマンド: 引数のファイル名で，内容が空のファイルを作成する
void handle_touch(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(作成するファイル名)
    struct FatEntry entry;  // 作成したファイルのエントリ
    int status;             // 作成の結果

    // コマンド名(touch)の直後の引数をファイル名として取り出す．引数が無いか余分な引数があれば，取り出す処理がエラーを出力するため何もせず終える
    if (extract_only_arg(pos, name) == 0) {
        return;
    }
    // ファイルを作成し，失敗すればその理由を出力する(同名のファイルが既にある場合も失敗になる)
    status = fat_create(name, &entry);
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// writeコマンド: 引数の先頭をファイル名，残りを内容として，ファイルの内容を丸ごと置き換える(ファイルが無ければ作成する)
void handle_write(int pos) {
    char name[INPUT_SIZE];     // 先頭の引数(書き込むファイル名)
    char content[INPUT_SIZE];  // ファイル名を除いた残り(書き込む内容)
    struct FatEntry entry;     // 書き込むファイルのエントリ
    int length = 0;            // 書き込む内容のバイト数
    int status;                // 検索・作成・書き込みの結果

    // コマンド名(write)の直後の引数をファイル名として取り出す
    pos = extract_arg(input, pos, name, INPUT_SIZE);
    // ファイル名が指定されていなければ何もしない
    if (name[0] == '\0') {
        print_error("missing argument\n");
        return;
    }
    // ファイル名以降の引数部分を丸ごと書き込む内容として取り出し，その長さを数える
    extract_text_arg(input, pos, content, INPUT_SIZE);
    while (content[length] != '\0') {
        length++;
    }

    // 書き込み先のファイルを決める．無ければ空のファイルを作成し，同名のファイルが既にあればそれを使う
    // 作成の処理は，同名のファイルがあれば作成せずにそのエントリを返してFAT_ERR_EXISTSを返すため，その場合も書き込み先が決まったものとして扱う
    // (名前での検索を別に行うと，作成の処理が同じ名前を探すためにディレクトリをもう一度走査することになるため，作成の処理に任せる)
    status = fat_create(name, &entry);
    if (status == FAT_ERR_EXISTS) {
        status = FAT_OK;
    }
    // 書き込み先が決まったときだけ，その内容を丸ごと置き換える
    if (status == FAT_OK) {
        status = fat_write(&entry, content, length);
    }
    // どこかで失敗していれば，その理由を出力する
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// rmコマンド: 引数のファイル名に対応するファイルを削除する
void handle_rm(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(削除するファイル名)
    struct FatEntry entry;  // 削除するファイルのエントリ
    int status;             // 検索・削除の結果

    // コマンド名(rm)の直後の引数をファイル名として取り出す．引数が無いか余分な引数があれば，取り出す処理がエラーを出力するため何もせず終える
    if (extract_only_arg(pos, name) == 0) {
        return;
    }
    // ファイル名から対象のエントリを探して削除し，失敗すればその理由を出力する
    status = fat_find(name, &entry);
    if (status == FAT_OK) {
        status = fat_remove(&entry);
    }
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// mvコマンド: 引数の先頭を旧ファイル名，次を新ファイル名として名前を変更する
void handle_mv(int pos) {
    char old_name[INPUT_SIZE];  // 先頭の引数(旧ファイル名)
    char new_name[INPUT_SIZE];  // 次の引数(新ファイル名)
    struct FatEntry entry;      // 名前を変更するエントリ
    int status;                 // 検索・名前の変更の結果

    // コマンド名(mv)の直後の2つの引数を，旧ファイル名・新ファイル名として順に取り出す
    pos = extract_arg(input, pos, old_name, INPUT_SIZE);
    pos = extract_arg(input, pos, new_name, INPUT_SIZE);
    // 新ファイル名が無ければ引数が足りないため何もしない(旧ファイル名だけを指定した場合と，引数を1つも指定しない場合の両方が当てはまる)
    if (new_name[0] == '\0') {
        print_error("missing argument\n");
        return;
    }
    // 新ファイル名の後に余分な引数があれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // 旧ファイル名から対象のエントリを探して名前を変更し，失敗すればその理由を出力する
    status = fat_find(old_name, &entry);
    if (status == FAT_OK) {
        status = fat_rename(&entry, new_name);
    }
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// mkdirコマンド: 引数の名前で，空のディレクトリを作成する
void handle_mkdir(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(作成するディレクトリ名)
    int status;             // 作成の結果

    // コマンド名(mkdir)の直後の引数をディレクトリ名として取り出す．引数が無いか余分な引数があれば，取り出す処理がエラーを出力するため何もせず終える
    if (extract_only_arg(pos, name) == 0) {
        return;
    }
    // ディレクトリを作成し，失敗すればその理由を出力する(同名のファイル・ディレクトリが既にある場合も失敗になる)
    status = fat_mkdir(name);
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// rmdirコマンド: 引数の名前に対応する空のディレクトリを削除する
void handle_rmdir(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(削除するディレクトリ名)
    struct FatEntry entry;  // 削除するディレクトリのエントリ
    int status;             // 検索・削除の結果

    // コマンド名(rmdir)の直後の引数をディレクトリ名として取り出す．引数が無いか余分な引数があれば，取り出す処理がエラーを出力するため何もせず終える
    if (extract_only_arg(pos, name) == 0) {
        return;
    }
    // ディレクトリ名から対象のエントリを探して削除し，失敗すればその理由を出力する(中身が残っている場合も失敗になる)
    status = fat_find(name, &entry);
    if (status == FAT_OK) {
        status = fat_rmdir(&entry);
    }
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// cdコマンド: 引数の名前のディレクトリへ現在のディレクトリを移す．引数が無ければルートディレクトリへ移す
void handle_cd(int pos) {
    char name[INPUT_SIZE];  // 先頭の引数(移動先のディレクトリ名)
    int status;             // 移動の結果

    // コマンド名(cd)の直後の引数をディレクトリ名として取り出す
    pos = extract_arg(input, pos, name, INPUT_SIZE);
    // 移動先の後に余分な引数があれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // 引数が無ければルートディレクトリへ，あればそのディレクトリへ移り，失敗すればその理由を出力する
    if (name[0] == '\0') {
        status = fat_chdir_root();
    } else {
        status = fat_chdir(name);
    }
    if (status != FAT_OK) {
        print_fat_error(status);
    }
}

// pwdコマンド: 現在のディレクトリの絶対パスを出力する
void handle_pwd(int pos) {
    char path[FAT_PATH_SIZE];  // 現在のディレクトリの絶対パス
    int status;                // パスの取得の結果

    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // パスを取り出して1行で出力し，失敗すればその理由を出力する
    status = fat_getcwd(path);
    if (status != FAT_OK) {
        print_fat_error(status);
        return;
    }
    print(path);
    print("\n");
}

// SDカードを初期化し，カード上のFAT32ファイルシステムをマウントする．各段階の成否を[ OK ]・[FAIL]の行で出力する
// 戻り値: 1(マウントまで成功) / 0(失敗．ファイルシステムは外れた状態になる)
int init_storage(void) {
    int status;  // マウントの結果

    // 初期化に失敗したときに前のカードのファイルシステムを使い続けないよう，先に外しておく
    fat_unmount();
    // ハードウェアの初期化として，SDカードを初期化する(各段階の行はドライバが出力する)
    if (sd_init() == 0) {
        return 0;
    }
    // 初期化できたカードのファイルシステムをマウントし，その成否を出力する
    // print_errorを使わないのは，起動時はコマンド名が入っておらず，行もprint_errorのバッファに収まらないため
    status = fat_mount();
    if (status != FAT_OK) {
        print("[FAIL] FAT32: mount: ");
        fat_print_error(status);
        return 0;
    }
    print("[ OK ] FAT32: mount\n");
    return 1;
}

// OS名Qosmosを大きな文字(アスキーアート)で出力し，副題を添える
void print_banner(void) {
    // figletのstandardフォントで描いた5行と，空行を挟んだ副題を出力する
    print("  ___\n");
    print(" / _ \\  ___  ___ _ __ ___   ___  ___\n");
    print("| | | |/ _ \\/ __| '_ ` _ \\ / _ \\/ __|\n");
    print("| |_| | (_) \\__ \\ | | | | | (_) \\__ \\\n");
    print(" \\__\\_\\\\___/|___/_| |_| |_|\\___/|___/\n");
    print("\n");
    print("   order out of chaos, on Qurge\n");
}

// OSの起動処理．ハードウェアを初期化してファイルシステムをマウントし，OS名を出力する
// 呼ぶたびにハードウェアの初期化からやり直すため，再起動にもそのまま使える
void boot(void) {
    int mounted;  // ファイルシステムをマウントできたか(0:失敗，1:成功)

    // ハードウェアを初期化し，ファイルシステムをマウントする
    mounted = init_storage();
    // 成否によらずOS名を出力する
    print_banner();
    // 失敗してもrebootでやり直せるよう，シェルはそのまま起動し，やり直し方を伝える
    if (mounted == 0) {
        print("Storage is not available. Insert a card and run reboot.\n");
    }
}

// rebootコマンド: OSを再起動する(電源投入時と同じ起動処理をやり直す)
void handle_reboot(int pos) {
    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // 起動処理をやり直す(失敗も各段階の行で伝わるため，コマンド名を前置したエラーは出さない)
    boot();
}

// helpコマンド: 利用可能なコマンドの一覧を表示する
void handle_help(int pos) {
    // 引数を取らないコマンドのため，引数が指定されていれば何もしない
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // シェルが受け付けるコマンド名を1行ずつ出力する
    print("echo\n");
    print("help\n");
    print("ls\n");
    print("cat\n");
    print("touch\n");
    print("write\n");
    print("rm\n");
    print("mv\n");
    print("mkdir\n");
    print("rmdir\n");
    print("cd\n");
    print("pwd\n");
    print("reboot\n");
}

// 未対応コマンドのエラーメッセージを表示する
void handle_unknown(void) {
    // 未対応である旨のエラーを出力する
    print_error("unknown command\n");
}

// 実行ファイルentryの内容を，コード領域の先頭から書き写す(大きさは検査済みのものを渡すこと)
int load_executable(struct FatEntry *entry) {
    struct FatFile file;                               // 読み出し中の実行ファイルの位置
    int length;                                        // 読み込んだセクタのうち内容にあたるバイト数
    int status;                                        // FAT32の各関数の結果
    unsigned int *src = (unsigned int *)fat_sector;    // 読み込んだセクタを4バイト単位で読む位置
    unsigned int *dst = (unsigned int *)CODE_ADDRESS;  // 次に書き込むコード領域の位置

    // 実行ファイルを先頭から読み出せるよう開く
    status = fat_open(entry, &file);
    if (status != FAT_OK) {
        return status;
    }
    // 1セクタずつ読み込み，全て読み終えるまで書き写す
    while (1) {
        // 次の1セクタを読み込む．全て読み終えていれば書き写し終えている
        status = fat_read(&file, &length);
        if (status == FAT_END) {
            return FAT_OK;
        }
        if (status != FAT_OK) {
            return status;
        }
        // 内容を4バイト単位で書き写す(大きさが命令のバイト数の倍数のため，最後のセクタの内容も4バイト単位で割り切れる．1バイトずつ写すより命令数が少ない)
        for (int i = 0; i < (length >> 2); i++) {
            *dst = src[i];
            dst++;
        }
    }
}

// 既定のディレクトリ/binから，コマンド名と同じ名前の実行ファイルを探し，コード領域へ読み込んで呼び出す
// 実行ファイルが見つからなければ，組み込みコマンドとも一致しなかったコマンドとして未対応のエラーにする
void run_executable(int pos) {
    struct FatEntry dir;    // 既定のディレクトリのエントリ
    struct FatEntry entry;  // 見つかった実行ファイルのエントリ
    int status;             // FAT32の各関数の結果

    // 空行とドットを含む名前は探さない(実行ファイルは拡張子の無いファイルに限り，データファイルを打ち間違いで命令として実行しないため)
    if (cmd[0] == '\0') {
        handle_unknown();
        return;
    }
    for (int i = 0; cmd[i] != '\0'; i++) {
        if (cmd[i] == '.') {
            handle_unknown();
            return;
        }
    }
    // 現在のディレクトリによらず，ルートディレクトリ直下の既定のディレクトリから探す
    status = fat_find_in(fat_root_cluster, "bin", &dir);
    // 既定の名前がディレクトリでなければ，既定のディレクトリが無いものとして扱う
    if (status == FAT_OK && (dir.attr & ATTR_DIRECTORY) == 0) {
        status = FAT_ERR_NOT_FOUND;
    }
    if (status == FAT_OK) {
        status = fat_find_in(dir.cluster, cmd, &entry);
    }
    // 既定のディレクトリか実行ファイルが無いか，名前がファイル名の規則に合わなければ，未対応のコマンドとして扱う
    if (status == FAT_ERR_NOT_FOUND || status == FAT_ERR_BAD_NAME) {
        handle_unknown();
        return;
    }
    // それ以外の失敗(マウントしていない場合を含む)は，その理由を出力する
    if (status != FAT_OK) {
        print_fat_error(status);
        return;
    }
    // ディレクトリは実行できない
    if ((entry.attr & ATTR_DIRECTORY) != 0) {
        print_fat_error(FAT_ERR_IS_DIR);
        return;
    }
    // 命令を1つ以上含み，コード領域に収まり，命令のバイト数で割り切れる大きさでなければ実行しない(命令のバイト数は2のべき乗のため，除算を避けて下位ビットで判定する)
    if (entry.size == 0 || entry.size > CODE_SIZE || (entry.size & (INSTRUCTION_SIZE - 1)) != 0) {
        print_error("invalid executable\n");
        return;
    }
    // 引数を渡す仕組みが無いため，引数が指定されていれば実行しない(実行できるものを見つけてから検査し，打ち間違いの名前に引数の誤りを出さない)
    if (has_extra_args(input, pos)) {
        print_error("too many arguments\n");
        return;
    }
    // コード領域へ読み込み，失敗すればその理由を出力する
    status = load_executable(&entry);
    if (status != FAT_OK) {
        print_fat_error(status);
        return;
    }
    // 入口の命令を呼び出す．実行ファイルがRETで戻れば，そのままプロンプトへ戻る
    ((void (*)(void))CODE_PC)();
}

// グローバル配列cmdの内容に応じた処理を呼び出す(streqは配列変数のみ受け付けるため，パラメータではなくグローバル配列を直接比較する)
// 引数の取り出し対象は1行分の入力を保持するinputで固定のため，コマンド側へは位置だけを渡す
void dispatch(int pos) {
    // コマンド名と一致する処理を呼び，どれとも一致しなければ既定のディレクトリの実行ファイルを探す
    if (streq(cmd, "echo")) {
        handle_echo(pos);
    } else if (streq(cmd, "help")) {
        handle_help(pos);
    } else if (streq(cmd, "ls")) {
        handle_ls(pos);
    } else if (streq(cmd, "cat")) {
        handle_cat(pos);
    } else if (streq(cmd, "touch")) {
        handle_touch(pos);
    } else if (streq(cmd, "write")) {
        handle_write(pos);
    } else if (streq(cmd, "rm")) {
        handle_rm(pos);
    } else if (streq(cmd, "mv")) {
        handle_mv(pos);
    } else if (streq(cmd, "mkdir")) {
        handle_mkdir(pos);
    } else if (streq(cmd, "rmdir")) {
        handle_rmdir(pos);
    } else if (streq(cmd, "cd")) {
        handle_cd(pos);
    } else if (streq(cmd, "pwd")) {
        handle_pwd(pos);
    } else if (streq(cmd, "reboot")) {
        handle_reboot(pos);
    } else {
        run_executable(pos);
    }
}

void main(void) {
    int pos;  // コマンド名の直後の位置(引数の取り出し開始位置)

    // OSを起動する
    boot();
    // 1行受け取るごとに，先頭のトークンをコマンド名として取り出して処理を呼び出す
    while (1) {
        print("> ");  // 入力待ちであることを示すプロンプト
        scan(input);
        pos = extract_arg(input, 0, cmd, INPUT_SIZE);
        dispatch(pos);
    }
}
