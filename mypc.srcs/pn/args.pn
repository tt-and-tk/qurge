// 入力行の解析．半角空白で区切られた引数を取り出す
#pragma once

// bufのpos文字目以降に連続する空白を読み飛ばした位置を返す
int skip_spaces(char *buf, int pos) {
    // 区切りとして扱うのは半角空白だけで，タブ等の他の空白文字は引数の一部になる
    while (buf[pos] == ' ') {
        pos = pos + 1;
    }
    return pos;
}

// bufのpos文字目以降から引数を1つargへ取り出し，その直後の位置を返す
// argへはarg_size-1文字まで書き込んで打ち切る．入力行と同じ幅でargを確保すれば打ち切りは起きない
int extract_arg(char *buf, int pos, char *arg, int arg_size) {
    int i = 0;
    // 引数の手前に連続する空白を読み飛ばす
    pos = skip_spaces(buf, pos);
    // 次の空白かヌル終端の直前までを1つの引数としてコピーする(引数が無ければ空文字列になる)
    while (buf[pos + i] != ' ' && buf[pos + i] != '\0' && i < arg_size - 1) {
        arg[i] = buf[pos + i];
        i = i + 1;
    }
    arg[i] = '\0';
    // 取り出した引数の直後の位置を返す(次の引数を取り出す際の開始位置になる)
    return pos + i;
}

// bufのpos文字目以降を丸ごと1つの引数としてargへ取り出す
// extract_argと同じく，argへはarg_size-1文字まで書き込んで打ち切る
void extract_text_arg(char *buf, int pos, char *arg, int arg_size) {
    int i = 0;
    // 引数の手前に連続する空白を読み飛ばす
    pos = skip_spaces(buf, pos);
    // 残りは原文のままコピーする(空白を区切りとせず引数の一部として扱う)
    while (buf[pos + i] != '\0' && i < arg_size - 1) {
        arg[i] = buf[pos + i];
        i = i + 1;
    }
    arg[i] = '\0';
}

// bufのpos文字目以降に引数が残っていれば1，残っていなければ0を返す
int has_extra_args(char *buf, int pos) {
    // 先頭の空白を読み飛ばす
    pos = skip_spaces(buf, pos);
    // 読み飛ばした先がヌル終端なら引数は残っていない
    return buf[pos] != '\0';
}
