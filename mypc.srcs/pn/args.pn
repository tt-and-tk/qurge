// 入力行の解析．半角空白で区切られた引数を取り出す
#pragma once

// bufのpos文字目以降に連続する空白を読み飛ばした位置を返す
int skip_spaces(char *buf, int pos) {
    // 区切りとして扱うのは半角空白だけで，タブ等の他の空白文字は引数の一部になる
    while (buf[pos] == ' ') {
        pos = pos + 1;
    }
    return pos;
}

// bufのpos文字目以降から引数を1つargへ取り出し，その直後の位置を返す
// argへはarg_size-1文字まで書き込んで打ち切る．入力行と同じ幅でargを確保すれば打ち切りは起きない
int extract_arg(char *buf, int pos, char *arg, int arg_size) {
    int i = 0;  // argへ写した文字数
    // 引数の手前に連続する空白を読み飛ばす
    pos = skip_spaces(buf, pos);
    // 次の空白かヌル終端の直前までを1つの引数としてコピーする(引数が無ければ空文字列になる)
    while (buf[pos + i] != ' ' && buf[pos + i] != '\0' && i < arg_size - 1) {
        arg[i] = buf[pos + i];
        i = i + 1;
    }
    arg[i] = '\0';
    // 取り出した引数の直後の位置を返す(次の引数を取り出す際の開始位置になる)
    return pos + i;
}

// bufのpos文字目以降を丸ごと1つの引数としてargへ取り出す
// extract_argと同じく，argへはarg_size-1文字まで書き込んで打ち切る
void extract_text_arg(char *buf, int pos, char *arg, int arg_size) {
    int i = 0;  // argへ写した文字数
    // 引数の手前に連続する空白を読み飛ばす
    pos = skip_spaces(buf, pos);
    // 残りは原文のままコピーする(空白を区切りとせず引数の一部として扱う)
    while (buf[pos + i] != '\0' && i < arg_size - 1) {
        arg[i] = buf[pos + i];
        i = i + 1;
    }
    arg[i] = '\0';
}

// bufを半角空白で区切り，各引数の先頭の位置をargvへ順に記録して，記録した数を返す
// 区切りの空白をヌル文字に置き換えてその場で各引数を終端するため，bufの内容は書き換わる．記録した引数の直後の要素にはnullptrを置く
// argvへはargv_size-1個まで記録して打ち切る．入力行の要素数の半分+1で確保すれば打ち切りは起きない
int split_args(char *buf, char **argv, int argv_size) {
    int count = 0;                  // 記録した引数の数
    int pos = skip_spaces(buf, 0);  // 次の引数の先頭の位置
    // 行末に達するか記録できる数に達するまで，引数を1つずつ記録する
    while (buf[pos] != '\0' && count < argv_size - 1) {
        argv[count] = &buf[pos];
        count = count + 1;
        // 引数の直後(次の空白かヌル終端)まで進める
        while (buf[pos] != ' ' && buf[pos] != '\0') {
            pos = pos + 1;
        }
        // 空白で終わっていれば，ヌル文字に置き換えて引数を終端し，続く空白を読み飛ばす
        if (buf[pos] == ' ') {
            buf[pos] = '\0';
            pos = skip_spaces(buf, pos + 1);
        }
    }
    // 引数の並びの終わりを示す
    argv[count] = nullptr;
    return count;
}

// bufのpos文字目以降に引数が残っていれば1，残っていなければ0を返す
int has_extra_args(char *buf, int pos) {
    // 先頭の空白を読み飛ばす
    pos = skip_spaces(buf, pos);
    // 読み飛ばした先がヌル終端なら引数は残っていない
    return buf[pos] != '\0';
}
